{
  "name": "CardapioInsumo",
  "type": "object",
  "properties": {
    "cardapio_id": {
      "type": "string",
      "description": "ID do card\u00e1pio"
    },
    "insumo_id": {
      "type": "string",
      "description": "ID do insumo no banco (se vinculado)"
    },
    "nome": {
      "type": "string",
      "description": "Nome do insumo"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade usada"
    },
    "unidade": {
      "type": "string",
      "description": "Unidade de medida"
    },
    "custo_unitario": {
      "type": "number",
      "description": "Custo unit\u00e1rio em R$"
    },
    "custo_total": {
      "type": "number",
      "description": "Cache do custo na escala-base cadastrada; o custo atual \u00e9 derivado pelo motor can\u00f4nico"
    },
    "comportamento_custo": {
      "type": "string",
      "enum": [
        "por_lote",
        "proporcional",
        "por_unidade"
      ],
      "default": "por_lote",
      "description": "por_lote = custo fixo do card\u00e1pio; proporcional = acompanha a varia\u00e7\u00e3o do n\u00famero de unidades em rela\u00e7\u00e3o \u00e0 escala-base; por_unidade = quantidade cadastrada por unidade final"
    },
    "escala_base_unidades": {
      "type": "number",
      "description": "N\u00famero de pessoas/unidades/kg do card\u00e1pio quando a quantidade proporcional foi cadastrada"
    },
    "modelo_custo_versao": {
      "type": "number",
      "default": 1,
      "description": "Vers\u00e3o da sem\u00e2ntica can\u00f4nica de escalonamento do insumo"
    },
    "is_base": {
      "type": "boolean",
      "description": "Espelha se o card\u00e1pio-pai pertence ao cat\u00e1logo-base compartilhado"
    },
    "usuario_dono_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio dono quando o card\u00e1pio-pai \u00e9 uma c\u00f3pia pessoal"
    }
  },
  "required": [
    "cardapio_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.is_base": false
            },
            {
              "data.usuario_dono_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.is_base": true
        },
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}