{
  "name": "CardapioInsumo",
  "type": "object",
  "properties": {
    "cardapio_id": {
      "type": "string",
      "description": "ID do cardápio"
    },
    "insumo_id": {
      "type": "string",
      "description": "ID do insumo no banco (se vinculado)"
    },
    "nome": {
      "type": "string",
      "description": "Nome do insumo"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade usada"
    },
    "unidade": {
      "type": "string",
      "description": "Unidade de medida"
    },
    "custo_unitario": {
      "type": "number",
      "description": "Custo unitário em R$"
    },
    "custo_total": {
      "type": "number",
      "description": "Custo total calculado"
    },
    "is_base": {
      "type": "boolean",
      "description": "Espelha se o cardápio-pai pertence ao catálogo-base compartilhado"
    },
    "usuario_dono_id": {
      "type": "string",
      "description": "ID do usuário dono quando o cardápio-pai é uma cópia pessoal"
    }
  },
  "required": [
    "cardapio_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.is_base": false
            },
            {
              "data.usuario_dono_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.is_base": true
        },
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
