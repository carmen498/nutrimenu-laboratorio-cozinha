{
  "name": "TesteLancamentoGuiaZR",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Conta autenticada que ativou o convite de lan\u00e7amento do Guia T\u00e9cnico ZR."
    },
    "nome": {
      "type": "string",
      "description": "Nome informado no formul\u00e1rio do convite."
    },
    "whatsapp": {
      "type": "string",
      "description": "WhatsApp normalizado com c\u00f3digo do pa\u00eds, somente d\u00edgitos."
    },
    "consentimento_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do consentimento para ativa\u00e7\u00e3o e orienta\u00e7\u00f5es sobre o Guia pelo WhatsApp."
    },
    "origem": {
      "type": "string",
      "enum": [
        "lancamento-guia-zr-outubro-2026"
      ],
      "description": "Campanha que originou a ativa\u00e7\u00e3o."
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "expirado",
        "cancelado"
      ],
      "default": "ativo"
    },
    "inicio_em": {
      "type": "string",
      "format": "date-time"
    },
    "fim_em": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "nome",
    "whatsapp",
    "consentimento_em",
    "origem",
    "status",
    "inicio_em",
    "fim_em"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}