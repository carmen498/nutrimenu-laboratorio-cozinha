{
  "name": "LogEncerramentoPix",
  "type": "object",
  "properties": {
    "pagamento_id": {
      "type": "string",
      "description": "ID do registro Pagamento encerrado ou analisado pela rotina."
    },
    "mercadopago_order_id": {
      "type": "string",
      "description": "ID da order no Mercado Pago consultada para reconfirma\u00e7\u00e3o."
    },
    "acao": {
      "type": "string",
      "enum": [
        "expirada",
        "aprovada_fora_prazo",
        "ignorada_status_origem",
        "ignorado_teste",
        "erro_consulta"
      ],
      "description": "Resultado da an\u00e1lise: 'expirada' = cobran\u00e7a encerrada; 'aprovada_fora_prazo' = provedor retornou aprovado, n\u00e3o tocada; 'ignorada_status_origem' = provedor retornou status terminal n\u00e3o-aprovado; 'ignorado_teste' = pagamento de teste (ORDTST) exclu\u00eddo do escopo; 'erro_consulta' = n\u00e3o foi poss\u00edvel consultar o provedor."
    },
    "status_origem": {
      "type": "string",
      "description": "Status resolvido na origem (provedor) no momento da confer\u00eancia."
    },
    "gerada_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de cria\u00e7\u00e3o do pagamento (quando a cobran\u00e7a foi gerada)."
    },
    "expirada_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que a cobran\u00e7a foi encerrada pela rotina, quando aplic\u00e1vel."
    },
    "versao_codigo": {
      "type": "string",
      "description": "Vers\u00e3o do c\u00f3digo da rotina que processou este registro."
    },
    "detalhe": {
      "type": "string",
      "description": "Resumo sanitizado do motivo da a\u00e7\u00e3o ou do erro de consulta."
    }
  },
  "required": [
    "pagamento_id",
    "acao"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}