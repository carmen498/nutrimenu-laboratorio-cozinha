{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ],
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "nome_completo": {
      "type": "string",
      "description": "Nome completo do usu\u00e1rio informado no cadastro (o campo full_name embutido n\u00e3o \u00e9 edit\u00e1vel e \u00e9 preenchido automaticamente pela plataforma)"
    },
    "telefone_whatsapp": {
      "type": "string",
      "description": "Telefone/WhatsApp do usu\u00e1rio (canal de contato principal)"
    },
    "empresa": {
      "type": "string",
      "description": "Empresa ou neg\u00f3cio do usu\u00e1rio"
    },
    "plano_atual": {
      "type": "string",
      "enum": [
        "trial",
        "mensal",
        "anual",
        "renovacao"
      ],
      "description": "Plano comercial atual do usu\u00e1rio",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "status_assinatura": {
      "type": "string",
      "enum": [
        "ativo",
        "trial",
        "vencido",
        "cancelado",
        "inativo"
      ],
      "description": "Status atual da assinatura do usu\u00e1rio. 'inativo' \u00e9 usado quando o admin desativa manualmente a conta",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio do plano/assinatura atual",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "data_expiracao": {
      "type": "string",
      "format": "date",
      "description": "Data em que o acesso deixa de ser v\u00e1lido se n\u00e3o houver renova\u00e7\u00e3o/pagamento",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "trial_modelo": {
      "type": "string",
      "enum": [
        "7_em_30"
      ],
      "description": "Modelo de trial: 7 dias distintos de uso dentro de uma janela m\u00e1xima de 30 dias.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "trial_dias_uso": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Datas ISO distintas em que o usu\u00e1rio efetivamente utilizou Cozinha ou Custos durante o trial.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "oferta_conversao_expira_em": {
      "type": "string",
      "format": "date-time",
      "description": "Fim da oferta de 48 h de primeira assinatura (fim do trial). Definida uma \u00fanica vez pelo servidor quando o trial entra na reta final.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "data_proxima_cobranca": {
      "type": "string",
      "format": "date",
      "description": "Data prevista da pr\u00f3xima cobran\u00e7a (planos recorrentes, opcional)",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "ciclo_renovacao": {
      "type": "number",
      "default": 0,
      "description": "Contador de quantas vezes o usu\u00e1rio j\u00e1 renovou o plano, usado para liberar o plano 'Renova\u00e7\u00e3o' a partir do 2\u00ba ano",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "pagamento_ativo_id": {
      "type": "string",
      "description": "ID do Pagamento que concedeu o acesso pago atualmente vigente. Usado para impedir que um estorno antigo revogue uma assinatura posterior.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF ou CNPJ para emiss\u00e3o de nota fiscal. Obrigat\u00f3rio para concluir uma compra."
    },
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o social, para nota fiscal de pessoa jur\u00eddica (opcional)"
    },
    "cep": {
      "type": "string",
      "description": "CEP para nota fiscal. Obrigat\u00f3rio para concluir uma compra."
    },
    "cidade_uf": {
      "type": "string",
      "description": "LEGADO: cidade/UF concatenados. Mantido em sincronia com cidade e estado."
    },
    "endereco": {
      "type": "string",
      "description": "LEGADO: endere\u00e7o concatenado. Mantido em sincronia com os campos detalhados abaixo."
    },
    "logradouro": {
      "type": "string",
      "description": "Logradouro (rua/avenida) para nota fiscal. Obrigat\u00f3rio para concluir uma compra."
    },
    "numero": {
      "type": "string",
      "description": "N\u00famero do endere\u00e7o para nota fiscal. Obrigat\u00f3rio para concluir uma compra."
    },
    "complemento": {
      "type": "string",
      "description": "Complemento do endere\u00e7o (apartamento, sala, bloco). Informar somente quando houver."
    },
    "bairro": {
      "type": "string",
      "description": "Bairro para nota fiscal. Obrigat\u00f3rio para concluir uma compra."
    },
    "cidade": {
      "type": "string",
      "description": "Cidade para nota fiscal. Obrigat\u00f3rio para concluir uma compra."
    },
    "estado": {
      "type": "string",
      "description": "UF para nota fiscal (2 letras). Obrigat\u00f3rio para concluir uma compra."
    },
    "segmento": {
      "type": "string",
      "enum": [
        "Nutricionista",
        "Chef de Cozinha",
        "Cozinha Industrial",
        "Estudante",
        "Fabricante de Produtos"
      ],
      "description": "Segmento profissional do usu\u00e1rio"
    },
    "origem": {
      "type": "string",
      "enum": [
        "Google",
        "Instagram",
        "Indica\u00e7\u00e3o de amigos",
        "Site",
        "Outros"
      ],
      "description": "Canal de origem/aquisi\u00e7\u00e3o do usu\u00e1rio"
    },
    "origem_cadastro": {
      "type": "string",
      "enum": [
        "guia_zr",
        "laboratorio_cozinha",
        "nao_informado"
      ],
      "default": "nao_informado",
      "description": "Produto pelo qual o usu\u00e1rio entrou na plataforma. 'guia_zr' = veio pela ponte /entrar-no-guia; 'laboratorio_cozinha' = cadastro direto no Laborat\u00f3rio; 'nao_informado' = origem n\u00e3o determinada (usu\u00e1rios j\u00e1 cadastrados antes do marcador)."
    },
    "data_login": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do \u00faltimo login do usu\u00e1rio (atualizado automaticamente)"
    },
    "anotacoes_admin": {
      "type": "string",
      "description": "Anota\u00e7\u00f5es internas sobre o cliente (contatos feitos, pedidos especiais, hist\u00f3rico). Vis\u00edvel e edit\u00e1vel apenas pelo admin, nunca pelo usu\u00e1rio titular",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "conta_teste": {
      "type": "boolean",
      "default": false,
      "description": "Marca administrativa. Pagamentos desta conta n\u00e3o entram nos n\u00fameros de vendas.",
      "rls": {
        "read": {
          "user_condition": {
            "role": "admin"
          }
        },
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "termos_aceitos_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora exata em que o usu\u00e1rio aceitou os Termos de Uso e a Pol\u00edtica de Privacidade no cadastro",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "termos_versao_aceita": {
      "type": "string",
      "description": "Vers\u00e3o dos Termos de Uso aceita pelo usu\u00e1rio no cadastro",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "privacidade_versao_aceita": {
      "type": "string",
      "description": "Vers\u00e3o da Pol\u00edtica de Privacidade aceita pelo usu\u00e1rio no cadastro",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "role"
  ]
}