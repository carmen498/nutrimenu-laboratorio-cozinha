{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "nome_completo": {
      "type": "string",
      "description": "Nome completo do usu\u00e1rio informado no cadastro (o campo full_name embutido n\u00e3o \u00e9 edit\u00e1vel e \u00e9 preenchido automaticamente pela plataforma)"
    },
    "telefone_whatsapp": {
      "type": "string",
      "description": "Telefone/WhatsApp do usu\u00e1rio (canal de contato principal)"
    },
    "empresa": {
      "type": "string",
      "description": "Empresa ou neg\u00f3cio do usu\u00e1rio"
    },
    "plano_atual": {
      "type": "string",
      "enum": [
        "trial",
        "mensal",
        "anual",
        "renovacao"
      ],
      "description": "Plano comercial atual do usu\u00e1rio"
    },
    "status_assinatura": {
      "type": "string",
      "enum": [
        "ativo",
        "trial",
        "vencido",
        "cancelado"
      ],
      "description": "Status atual da assinatura do usu\u00e1rio"
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio do plano/assinatura atual"
    },
    "data_expiracao": {
      "type": "string",
      "format": "date",
      "description": "Data em que o acesso deixa de ser v\u00e1lido se n\u00e3o houver renova\u00e7\u00e3o/pagamento"
    },
    "data_proxima_cobranca": {
      "type": "string",
      "format": "date",
      "description": "Data prevista da pr\u00f3xima cobran\u00e7a (planos recorrentes, opcional)"
    },
    "ciclo_renovacao": {
      "type": "number",
      "default": 0,
      "description": "Contador de quantas vezes o usu\u00e1rio j\u00e1 renovou o plano, usado para liberar o plano 'Renova\u00e7\u00e3o' a partir do 2\u00ba ano"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF ou CNPJ para emiss\u00e3o de nota fiscal (opcional, preenchido s\u00f3 se o cliente pedir nota)"
    },
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o social, para nota fiscal de pessoa jur\u00eddica (opcional)"
    },
    "cep": {
      "type": "string",
      "description": "CEP para nota fiscal (opcional)"
    },
    "cidade_uf": {
      "type": "string",
      "description": "Cidade/UF para nota fiscal (opcional)"
    },
    "endereco": {
      "type": "string",
      "description": "Endere\u00e7o completo para nota fiscal (opcional)"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}