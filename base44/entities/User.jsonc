{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "nome_completo": {
      "type": "string",
      "description": "Nome completo do usu\u00e1rio informado no cadastro (o campo full_name embutido n\u00e3o \u00e9 edit\u00e1vel e \u00e9 preenchido automaticamente pela plataforma)"
    },
    "telefone_whatsapp": {
      "type": "string",
      "description": "Telefone/WhatsApp do usu\u00e1rio (canal de contato principal)"
    },
    "empresa": {
      "type": "string",
      "description": "Empresa ou neg\u00f3cio do usu\u00e1rio"
    },
    "plano_atual": {
      "type": "string",
      "enum": [
        "trial",
        "mensal",
        "anual",
        "renovacao"
      ],
      "description": "Plano comercial atual do usu\u00e1rio"
    },
    "status_assinatura": {
      "type": "string",
      "enum": [
        "ativo",
        "trial",
        "vencido",
        "cancelado",
        "inativo"
      ],
      "description": "Status atual da assinatura do usu\u00e1rio. 'inativo' \u00e9 usado quando o admin desativa manualmente a conta"
    },
    "data_inicio": {
      "type": "string",
      "format": "date",
      "description": "Data de in\u00edcio do plano/assinatura atual"
    },
    "data_expiracao": {
      "type": "string",
      "format": "date",
      "description": "Data em que o acesso deixa de ser v\u00e1lido se n\u00e3o houver renova\u00e7\u00e3o/pagamento"
    },
    "data_proxima_cobranca": {
      "type": "string",
      "format": "date",
      "description": "Data prevista da pr\u00f3xima cobran\u00e7a (planos recorrentes, opcional)"
    },
    "ciclo_renovacao": {
      "type": "number",
      "default": 0,
      "description": "Contador de quantas vezes o usu\u00e1rio j\u00e1 renovou o plano, usado para liberar o plano 'Renova\u00e7\u00e3o' a partir do 2\u00ba ano"
    },
    "cpf_cnpj": {
      "type": "string",
      "description": "CPF ou CNPJ para emiss\u00e3o de nota fiscal (opcional, preenchido s\u00f3 se o cliente pedir nota)"
    },
    "razao_social": {
      "type": "string",
      "description": "Raz\u00e3o social, para nota fiscal de pessoa jur\u00eddica (opcional)"
    },
    "cep": {
      "type": "string",
      "description": "CEP para nota fiscal (opcional)"
    },
    "cidade_uf": {
      "type": "string",
      "description": "Cidade/UF para nota fiscal (opcional)"
    },
    "endereco": {
      "type": "string",
      "description": "Endere\u00e7o completo para nota fiscal (opcional)"
    },
    "segmento": {
      "type": "string",
      "enum": [
        "Nutricionista",
        "Chef de Cozinha",
        "Cozinha Industrial",
        "Estudante",
        "Fabricante de Produtos"
      ],
      "description": "Segmento profissional do usu\u00e1rio"
    },
    "origem": {
      "type": "string",
      "enum": [
        "Google",
        "Instagram",
        "Indica\u00e7\u00e3o de amigos",
        "Site",
        "Outros"
      ],
      "description": "Canal de origem/aquisi\u00e7\u00e3o do usu\u00e1rio"
    },
    "data_login": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do \u00faltimo login do usu\u00e1rio (atualizado automaticamente)"
    },
    "anotacoes_admin": {
      "type": "string",
      "description": "Anota\u00e7\u00f5es internas sobre o cliente (contatos feitos, pedidos especiais, hist\u00f3rico). Vis\u00edvel e edit\u00e1vel apenas pelo admin, nunca pelo usu\u00e1rio titular"
    },
    "termos_aceitos_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora exata em que o usu\u00e1rio aceitou os Termos de Uso e a Pol\u00edtica de Privacidade no cadastro"
    },
    "termos_versao_aceita": {
      "type": "string",
      "description": "Vers\u00e3o do documento de Termos de Uso aceita pelo usu\u00e1rio no cadastro (ex: 'Termos de Uso v.18/08/2026'), para fins de prova de aceite"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}