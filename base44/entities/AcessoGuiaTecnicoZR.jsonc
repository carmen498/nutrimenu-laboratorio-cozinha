{
  "name": "AcessoGuiaTecnicoZR",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio titular desta faixa do Guia T\u00e9cnico ZR."
    },
    "faixa": {
      "type": "string",
      "enum": [
        "tin",
        "full",
        "arquitetura-do-rotulo"
      ],
      "description": "Faixa comprada. As faixas ACUMULAM: um usu\u00e1rio pode ter v\u00e1rios registros, um por faixa. 'acesso-livre' nunca \u00e9 persistido aqui \u2014 \u00e9 o piso de todos, aplicado pelo pr\u00f3prio Guia."
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "ativo",
        "suspenso",
        "cancelado",
        "expirado"
      ],
      "default": "pendente",
      "description": "Estado persistido do acesso. A validade temporal tamb\u00e9m \u00e9 conferida por inicio_em/fim_em."
    },
    "vitalicio": {
      "type": "boolean",
      "default": false,
      "description": "true quando a faixa n\u00e3o expira. Nesse caso fim_em \u00e9 ignorado."
    },
    "modalidade": {
      "type": "string",
      "enum": [
        "anual",
        "vitalicio",
        "cortesia",
        "admin",
        "migracao"
      ],
      "description": "Modalidade comercial ou administrativa que originou o acesso."
    },
    "origem": {
      "type": "string",
      "enum": [
        "admin",
        "checkout",
        "cortesia",
        "migracao"
      ],
      "default": "admin",
      "description": "Origem da concess\u00e3o do entitlement."
    },
    "inicio_em": {
      "type": "string",
      "format": "date-time",
      "description": "In\u00edcio da validade do acesso."
    },
    "fim_em": {
      "type": "string",
      "format": "date-time",
      "description": "Fim da validade do acesso. Vazio + vitalicio=false significa sem prazo definido."
    },
    "referencia_pagamento_id": {
      "type": "string",
      "description": "Pagamento que concedeu esta faixa, quando houver checkout integrado."
    },
    "cancelado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do cancelamento, quando aplic\u00e1vel."
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o administrativa sobre a concess\u00e3o/cancelamento."
    }
  },
  "required": [
    "user_id",
    "faixa",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}