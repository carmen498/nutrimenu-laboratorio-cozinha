{
  "name": "PrecoIngredienteCliente",
  "type": "object",
  "properties": {
    "ingrediente_id": {
      "type": "string",
      "description": "LEGADO FASE 3: ID do Ingrediente mestre ao qual este preço personalizado se refere"
    },
    "user_id": {
      "type": "string",
      "description": "LEGADO FASE 3: ID do usuário dono deste preço personalizado (cache; segurança usa created_by_id)"
    },
    "preco_por_g_rs": {
      "type": "number",
      "description": "LEGADO FASE 3: espelho temporário do preço pessoal. A fonte principal passou a ser IngredienteUsuario."
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da última atualização do espelho legado"
    }
  },
  "required": [
    "ingrediente_id",
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}