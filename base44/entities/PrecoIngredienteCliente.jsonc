{
  "name": "PrecoIngredienteCliente",
  "type": "object",
  "properties": {
    "ingrediente_id": {
      "type": "string",
      "description": "ID do Ingrediente base ao qual este pre\u00e7o personalizado se refere"
    },
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio dono deste pre\u00e7o personalizado (cache; a seguran\u00e7a usa created_by_id)"
    },
    "preco_por_g_rs": {
      "type": "number",
      "description": "Pre\u00e7o por grama/ml personalizado (R$) \u2014 sobrescreve o pre\u00e7o base do Ingrediente apenas para este usu\u00e1rio"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da \u00faltima atualiza\u00e7\u00e3o deste pre\u00e7o personalizado"
    }
  },
  "required": [
    "ingrediente_id",
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}