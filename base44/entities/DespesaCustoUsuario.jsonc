{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio dono da despesa; seguran\u00e7a efetiva baseada em created_by_id."
    },
    "grupo": {
      "type": "string",
      "enum": [
        "gastos_negocio",
        "trabalho_ajudantes",
        "producao",
        "embalagem_outros"
      ],
      "description": "Grupo visual da despesa no Laborat\u00f3rio de Custos."
    },
    "nome": {
      "type": "string",
      "description": "Nome da despesa."
    },
    "valor_mensal": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Valor mensal informado, em R$."
    },
    "ativo": {
      "type": "boolean",
      "default": true,
      "description": "Quando false, a despesa n\u00e3o entra no rateio."
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem opcional de exibi\u00e7\u00e3o dentro do grupo."
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o pessoal opcional sobre a despesa."
    }
  },
  "required": [
    "user_id",
    "grupo",
    "nome"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "name": "DespesaCustoUsuario"
}