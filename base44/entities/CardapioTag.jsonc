{
  "name": "CardapioTag",
  "type": "object",
  "properties": {
    "cardapio_id": {
      "type": "string",
      "description": "ID do cardápio"
    },
    "tag_id": {
      "type": "string",
      "description": "ID da tag"
    },
    "tag_nome": {
      "type": "string",
      "description": "Nome da tag (cache)"
    },
    "tag_grupo": {
      "type": "string",
      "description": "Grupo da tag (cache)"
    },
    "tag_cor": {
      "type": "string",
      "description": "Cor da tag (cache)"
    },
    "is_base": {
      "type": "boolean",
      "description": "Espelha se o cardápio-pai pertence ao catálogo-base compartilhado"
    },
    "usuario_dono_id": {
      "type": "string",
      "description": "ID do usuário dono quando o cardápio-pai é uma cópia pessoal"
    }
  },
  "required": [
    "cardapio_id",
    "tag_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.is_base": false
            },
            {
              "data.usuario_dono_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.is_base": true
        },
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
