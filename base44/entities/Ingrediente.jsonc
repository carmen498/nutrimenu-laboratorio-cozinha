{
  "name": "Ingrediente",
  "type": "object",
  "properties": {
    "categoria": {
      "type": "string",
      "enum": [
        "Carnes e Ovos",
        "Verduras e Hortaliças",
        "Temperos",
        "Laticínios",
        "Panificação e Cereais",
        "Açúcares e Doces",
        "Diversos",
        "A Revisar",
        "Peixes e Frutos do Mar",
        "Frutas",
        "Óleos e Gorduras"
      ],
      "description": "Categoria do ingrediente"
    },
    "nome": {
      "type": "string",
      "description": "Nome do ingrediente"
    },
    "unidade_compra": {
      "type": "string",
      "description": "Unidade de compra (G, KG, LT, UN, MOLHO, CX, PACOTE, BALDE...)"
    },
    "peso_embalagem_g": {
      "type": "number",
      "description": "Peso da embalagem em gramas (ou ml para líquidos)"
    },
    "preco_embalagem_rs": {
      "type": "number",
      "description": "Preço pago pela embalagem em R$"
    },
    "preco_por_g_rs": {
      "type": "number",
      "description": "Calculado: preco_embalagem_rs / peso_embalagem_g"
    },
    "fator_correcao": {
      "type": "number",
      "description": "Fator de correção (padrão 1.0)"
    },
    "revisar": {
      "type": "boolean",
      "description": "Flag: Duplicado — revisar"
    },
    "favorito": {
      "type": "boolean",
      "default": false,
      "description": "LEGADO: não gravar novas preferências aqui. Favoritos por usuário ficam em IngredienteUsuario."
    },
    "preco_estimado": {
      "type": "boolean",
      "default": false,
      "description": "Preço é estimado por IA, não confirmado manualmente"
    },
    "preco_atualizado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data da última atualização do preço"
    },
    "fonte_preco": {
      "type": "string",
      "enum": [
        "Manual",
        "IA web",
        "CONAB",
        "CEASA"
      ],
      "description": "Fonte da última atualização de preço"
    },
    "preco_medio_nacional": {
      "type": "number",
      "description": "Preço médio nacional de referência (R$/kg)"
    },
    "variacao_percentual": {
      "type": "number",
      "description": "Variação % em relação ao preço anterior"
    },
    "estado_usuario": {
      "type": "string",
      "description": "Estado do usuário para preços regionalizados (uso futuro CONAB/CEASA)"
    },
    "fornecedor": {
      "type": "string",
      "description": "Nome do fornecedor atual do ingrediente"
    },
    "historico_precos": {
      "type": "array",
      "description": "Histórico de preços (todas as atualizações)",
      "items": {
        "type": "object",
        "properties": {
          "data": { "type": "string", "format": "date-time" },
          "preco_por_kg": { "type": "number" },
          "variacao_percentual": { "type": "number" },
          "fonte": { "type": "string" },
          "fornecedor": { "type": "string" }
        }
      }
    }
  },
  "required": ["nome"],
  "rls": {
    "read": {},
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}