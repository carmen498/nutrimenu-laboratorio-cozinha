{
  "name": "Ingrediente",
  "type": "object",
  "properties": {
    "categoria": {
      "type": "string",
      "enum": [
        "Carnes e Ovos",
        "Verduras e Hortaliças",
        "Temperos",
        "Laticínios",
        "Panificação e Cereais",
        "Açúcares e Doces",
        "Diversos",
        "A Revisar",
        "Peixes e Frutos do Mar",
        "Frutas",
        "Óleos e Gorduras"
      ],
      "description": "DADO MESTRE: categoria técnica do ingrediente"
    },
    "nome": {
      "type": "string",
      "description": "DADO MESTRE: nome canônico do ingrediente"
    },
    "unidade_compra": {
      "type": "string",
      "description": "REFERÊNCIA GLOBAL/LEGADO: unidade de compra padrão. Dados pessoais ficam em IngredienteUsuario."
    },
    "peso_embalagem_g": {
      "type": "number",
      "description": "REFERÊNCIA GLOBAL/LEGADO: embalagem padrão em g/ml. Dados pessoais ficam em IngredienteUsuario."
    },
    "preco_embalagem_rs": {
      "type": "number",
      "description": "REFERÊNCIA GLOBAL: preço de referência da embalagem. Preço de compra do cliente fica em IngredienteUsuario."
    },
    "preco_por_g_rs": {
      "type": "number",
      "description": "REFERÊNCIA GLOBAL: preço por g/ml usado como fallback quando o usuário não possui preço pessoal."
    },
    "fator_correcao": {
      "type": "number",
      "description": "DADO MESTRE TÉCNICO: fator de correção padrão (1.0 quando não há perda)"
    },
    "revisar": {
      "type": "boolean",
      "description": "Flag global de qualidade cadastral: ingrediente precisa de revisão"
    },
    "favorito": {
      "type": "boolean",
      "default": false,
      "description": "LEGADO: não gravar novas preferências aqui. Favoritos por usuário ficam em IngredienteUsuario."
    },
    "preco_estimado": {
      "type": "boolean",
      "default": false,
      "description": "REFERÊNCIA GLOBAL: preço de referência estimado por IA e ainda não confirmado manualmente"
    },
    "preco_atualizado_em": {
      "type": "string",
      "format": "date-time",
      "description": "REFERÊNCIA GLOBAL: data da última atualização do preço de referência"
    },
    "fonte_preco": {
      "type": "string",
      "enum": [
        "Manual",
        "IA web",
        "CONAB",
        "CEASA"
      ],
      "description": "REFERÊNCIA GLOBAL: fonte da última atualização do preço de referência"
    },
    "preco_medio_nacional": {
      "type": "number",
      "description": "REFERÊNCIA GLOBAL: preço médio nacional (R$/kg)"
    },
    "variacao_percentual": {
      "type": "number",
      "description": "REFERÊNCIA GLOBAL: variação percentual do preço de referência"
    },
    "estado_usuario": {
      "type": "string",
      "description": "LEGADO: não usar para novos dados pessoais. Estado do cliente fica em IngredienteUsuario."
    },
    "fornecedor": {
      "type": "string",
      "description": "REFERÊNCIA GLOBAL/LEGADO: fornecedor padrão. Fornecedor do cliente fica em IngredienteUsuario."
    },
    "historico_precos": {
      "type": "array",
      "description": "REFERÊNCIA GLOBAL: histórico das atualizações do preço de referência",
      "items": {
        "type": "object",
        "properties": {
          "data": { "type": "string", "format": "date-time" },
          "preco_por_kg": { "type": "number" },
          "variacao_percentual": { "type": "number" },
          "fonte": { "type": "string" },
          "fornecedor": { "type": "string" }
        }
      }
    }
  },
  "required": ["nome"],
  "rls": {
    "read": {},
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}