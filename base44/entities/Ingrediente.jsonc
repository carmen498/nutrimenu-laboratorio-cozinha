{
  "name": "Ingrediente",
  "type": "object",
  "properties": {
    "categoria": {
      "type": "string",
      "enum": [
        "Carnes e Ovos",
        "Verduras e Hortali\u00e7as",
        "TEMPEROS",
        "LATIC\u00cdNIOS",
        "Panifica\u00e7\u00e3o e Cereais",
        "ENLATADOS",
        "A\u00e7\u00facares e Doces",
        "DIVERSOS",
        "A Revisar",
        "Receitas B\u00e1sicas",
        "Peixes e Frutos do Mar",
        "Frutas",
        "\u00d3leos e Gorduras"
      ],
      "description": "Categoria do ingrediente"
    },
    "nome": {
      "type": "string",
      "description": "Nome do ingrediente"
    },
    "unidade_compra": {
      "type": "string",
      "description": "Unidade de compra (G, KG, LT, UN, MOLHO, CX, PACOTE, BALDE...)"
    },
    "peso_embalagem_g": {
      "type": "number",
      "description": "Peso da embalagem em gramas (ou ml para l\u00edquidos)"
    },
    "preco_embalagem_rs": {
      "type": "number",
      "description": "Pre\u00e7o pago pela embalagem em R$"
    },
    "preco_por_g_rs": {
      "type": "number",
      "description": "Calculado: preco_embalagem_rs / peso_embalagem_g"
    },
    "fator_correcao": {
      "type": "number",
      "description": "Fator de corre\u00e7\u00e3o (padr\u00e3o 1.0)"
    },
    "revisar": {
      "type": "boolean",
      "description": "Flag: Duplicado \u2014 revisar"
    },
    "favorito": {
      "type": "boolean",
      "default": false,
      "description": "Ingrediente marcado como favorito"
    },
    "preco_estimado": {
      "type": "boolean",
      "default": false,
      "description": "Pre\u00e7o \u00e9 estimado por IA, n\u00e3o confirmado manualmente"
    },
    "preco_atualizado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima atualiza\u00e7\u00e3o do pre\u00e7o"
    },
    "fonte_preco": {
      "type": "string",
      "enum": [
        "Manual",
        "IA web",
        "CONAB",
        "CEASA"
      ],
      "description": "Fonte da \u00faltima atualiza\u00e7\u00e3o de pre\u00e7o"
    },
    "preco_medio_nacional": {
      "type": "number",
      "description": "Pre\u00e7o m\u00e9dio nacional de refer\u00eancia (R$/kg)"
    },
    "variacao_percentual": {
      "type": "number",
      "description": "Varia\u00e7\u00e3o % em rela\u00e7\u00e3o ao pre\u00e7o anterior"
    },
    "estado_usuario": {
      "type": "string",
      "description": "Estado do usu\u00e1rio para pre\u00e7os regionalizados (uso futuro CONAB/CEASA)"
    },
    "historico_precos": {
      "type": "array",
      "description": "Hist\u00f3rico de pre\u00e7os (\u00faltimas 5 atualiza\u00e7\u00f5es)",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "preco_por_kg": {
            "type": "number"
          },
          "variacao_percentual": {
            "type": "number"
          },
          "fonte": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "nome"
  ]
}