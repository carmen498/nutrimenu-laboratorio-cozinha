{
  "name": "Cardapio",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do card\u00e1pio"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "diario",
        "semanal",
        "fim_de_semana",
        "especial",
        "comemoracao",
        "marmitas",
        "buffet",
        "happy_hour",
        "personalizado"
      ],
      "description": "Tipo do card\u00e1pio"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data do card\u00e1pio (opcional)"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es gerais (produ\u00e7\u00e3o)"
    },
    "observacoes_orcamento": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es comerciais do Or\u00e7amento (documento do cliente) \u2014 distintas das observa\u00e7\u00f5es de produ\u00e7\u00e3o"
    },
    "num_unidades": {
      "type": "number",
      "description": "N\u00famero de pessoas, unidades ou kg conforme o tipo"
    },
    "favorito": {
      "type": "boolean",
      "default": false,
      "description": "Card\u00e1pio favorito"
    },
    "custo_total": {
      "type": "number",
      "description": "Custo total calculado do card\u00e1pio"
    },
    "custo_por_unidade": {
      "type": "number",
      "description": "Custo por pessoa/unidade/kg"
    },
    "markup_percentual": {
      "type": "number",
      "description": "Markup percentual para venda"
    },
    "preco_venda_sugerido": {
      "type": "number",
      "description": "Pre\u00e7o de venda sugerido"
    },
    "is_base": {
      "type": "boolean",
      "default": true,
      "description": "true = card\u00e1pio do cat\u00e1logo compartilhado original; false = c\u00f3pia pessoal criada automaticamente ao editar (fork-on-edit)"
    },
    "forked_from_id": {
      "type": "string",
      "description": "Quando is_base=false, ID do card\u00e1pio original (is_base=true) do qual este \u00e9 uma c\u00f3pia"
    },
    "cardapio_origem_id": {
      "type": "string",
      "description": "Feature 'Meus Card\u00e1pios': quando preenchido, indica que este \u00e9 uma c\u00f3pia pessoal derivada de outro card\u00e1pio. Aponta para o ID do card\u00e1pio original."
    },
    "usuario_dono_id": {
      "type": "string",
      "description": "Feature 'Meus Card\u00e1pios': ID do usu\u00e1rio dono desta c\u00f3pia pessoal. Se nulo, o card\u00e1pio \u00e9 original/p\u00fablico do Laborat\u00f3rio."
    },
    "data_personalizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Feature 'Meus Card\u00e1pios': data/hora de cria\u00e7\u00e3o da c\u00f3pia pessoal (preenchida automaticamente)"
    }
  },
  "required": [
    "nome",
    "tipo"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_base": true
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}