{
  "name": "LogWebhookMercadoPago",
  "type": "object",
  "properties": {
    "data_id": {
      "type": "string",
      "description": "ID recebido no campo data.id da notifica\u00e7\u00e3o (pode ser order ou payment)"
    },
    "tipo_notificacao": {
      "type": "string",
      "description": "Campo 'type'/'topic' enviado pelo Mercado Pago no corpo da notifica\u00e7\u00e3o, quando presente"
    },
    "assinatura_valida": {
      "type": "boolean",
      "description": "Se a valida\u00e7\u00e3o HMAC do header x-signature passou"
    },
    "resultado": {
      "type": "string",
      "enum": [
        "assinatura_invalida",
        "sem_data_id",
        "order_nao_encontrada",
        "pagamento_interno_nao_encontrado",
        "status_nao_final",
        "processado",
        "tipo_nao_mapeado"
      ],
      "description": "Em qual ponto o processamento parou (ou terminou com sucesso)"
    },
    "pagamento_id": {
      "type": "string",
      "description": "ID do registro Pagamento interno resolvido, quando encontrado"
    },
    "status_resolvido": {
      "type": "string",
      "description": "Status final calculado (approved/rejected/cancelled), quando aplic\u00e1vel"
    },
    "acao_notificacao": {
      "type": "string",
      "description": "A\u00e7\u00e3o t\u00e9cnica da notifica\u00e7\u00e3o (ex: order.processed), sem persistir o corpo bruto"
    },
    "versao_codigo": {
      "type": "string",
      "description": "Vers\u00e3o do c\u00f3digo do webhook que processou a notifica\u00e7\u00e3o"
    },
    "diagnostico_resumo": {
      "type": "string",
      "description": "Resumo n\u00e3o sens\u00edvel do diagn\u00f3stico de assinatura, quando inv\u00e1lida"
    }
  },
  "required": [
    "resultado"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}