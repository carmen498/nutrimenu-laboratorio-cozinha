{
  "name": "LogWebhookMercadoPago",
  "type": "object",
  "properties": {
    "data_id": {
      "type": "string",
      "description": "ID recebido no campo data.id da notifica\u00e7\u00e3o (pode ser order ou payment)"
    },
    "tipo_notificacao": {
      "type": "string",
      "description": "Campo 'type'/'topic' enviado pelo Mercado Pago no corpo da notifica\u00e7\u00e3o, quando presente"
    },
    "assinatura_valida": {
      "type": "boolean",
      "description": "Se a valida\u00e7\u00e3o HMAC do header x-signature passou"
    },
    "resultado": {
      "type": "string",
      "enum": [
        "assinatura_invalida",
        "sem_data_id",
        "order_nao_encontrada",
        "pagamento_interno_nao_encontrado",
        "status_nao_final",
        "processado",
        "tipo_nao_mapeado"
      ],
      "description": "Em qual ponto o processamento parou (ou terminou com sucesso)"
    },
    "pagamento_id": {
      "type": "string",
      "description": "ID do registro Pagamento interno resolvido, quando encontrado"
    },
    "status_resolvido": {
      "type": "string",
      "description": "Status final calculado (approved/rejected/cancelled), quando aplic\u00e1vel"
    },
    "corpo_bruto": {
      "type": "string",
      "description": "Corpo JSON bruto da notifica\u00e7\u00e3o recebida (para diagn\u00f3stico)"
    }
  },
  "required": [
    "resultado"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}