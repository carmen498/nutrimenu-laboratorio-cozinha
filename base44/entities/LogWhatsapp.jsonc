{
  "name": "LogWhatsapp",
  "type": "object",
  "properties": {
    "destinatario_telefone": {
      "type": "string",
      "description": "N\u00famero de telefone (com DDI) para o qual a mensagem foi enviada/simulada"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "pagamento_aprovado",
        "pagamento_recusado",
        "plano_vencendo"
      ],
      "description": "Tipo do evento transacional que originou o envio"
    },
    "modo_teste": {
      "type": "boolean",
      "default": true,
      "description": "true quando a mensagem foi apenas simulada/logada (modo de teste), sem envio real"
    },
    "status": {
      "type": "string",
      "enum": [
        "enviado",
        "falhou",
        "simulado"
      ],
      "description": "Resultado do envio"
    },
    "resposta_bruta": {
      "type": "string",
      "description": "Conte\u00fado da mensagem (modo teste) ou resposta bruta da API Wascript (envio real), para diagn\u00f3stico"
    }
  },
  "required": [
    "destinatario_telefone",
    "tipo",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}