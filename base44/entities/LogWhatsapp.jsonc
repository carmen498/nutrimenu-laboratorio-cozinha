{
  "name": "LogWhatsapp",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string",
      "description": "ID t\u00e9cnico do usu\u00e1rio destinat\u00e1rio, quando dispon\u00edvel; usado para deduplica\u00e7\u00e3o sem depender do telefone em claro"
    },
    "destinatario_telefone": {
      "type": "string",
      "description": "Telefone mascarado do destinat\u00e1rio (somente os 4 \u00faltimos d\u00edgitos); novos registros n\u00e3o persistem o n\u00famero completo"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "pagamento_aprovado",
        "pagamento_recusado",
        "plano_vencendo",
        "pagamento_pendente_lembrete",
        "pagamento_estornado"
      ],
      "description": "Tipo do evento transacional que originou o envio"
    },
    "modo_teste": {
      "type": "boolean",
      "default": true,
      "description": "true quando a mensagem foi apenas simulada/logada, sem envio real"
    },
    "status": {
      "type": "string",
      "enum": [
        "enviado",
        "falhou",
        "simulado"
      ],
      "description": "Resultado do envio"
    }
  },
  "required": [
    "destinatario_telefone",
    "tipo",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}