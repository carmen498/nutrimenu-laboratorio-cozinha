{
  "name": "IngredienteEsquecidoReceita",
  "type": "object",
  "properties": {
    "receita_id": {
      "type": "string",
      "description": "ID da receita"
    },
    "nome": {
      "type": "string",
      "description": "Nome do ingrediente esquecido"
    },
    "quantidade_g": {
      "type": "number",
      "description": "Quantidade em gramas"
    },
    "ingrediente_id": {
      "type": "string",
      "description": "ID do ingrediente no banco (se encontrado)"
    },
    "custo_unitario": {
      "type": "number",
      "description": "Preço por grama do ingrediente correspondente"
    },
    "custo_total": {
      "type": "number",
      "description": "Custo total calculado: quantidade_g * custo_unitario"
    },
    "is_base": {
      "type": "boolean",
      "description": "Espelha se o receita-pai pertence ao catálogo-base compartilhado"
    },
    "usuario_dono_id": {
      "type": "string",
      "description": "ID do usuário dono quando o receita-pai é uma cópia pessoal"
    }
  },
  "required": [
    "receita_id",
    "nome"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.is_base": false
            },
            {
              "data.usuario_dono_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.is_base": true
        },
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
