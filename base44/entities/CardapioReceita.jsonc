{
  "name": "CardapioReceita",
  "type": "object",
  "properties": {
    "cardapio_id": {
      "type": "string",
      "description": "ID do card\u00e1pio"
    },
    "receita_id": {
      "type": "string",
      "description": "ID da receita"
    },
    "receita_nome": {
      "type": "string",
      "description": "Nome da receita (cache)"
    },
    "receita_categoria": {
      "type": "string",
      "description": "Categoria da receita (cache)"
    },
    "per_capita_g": {
      "type": "number",
      "description": "Quantidade per capita em gramas (ou kg para buffet)"
    },
    "quantidade_total_g": {
      "type": "number",
      "description": "Quantidade total calculada (g ou kg conforme tipo)"
    },
    "custo_total": {
      "type": "number",
      "description": "Custo total calculado da receita no card\u00e1pio"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "dia_semana": {
      "type": "string",
      "enum": [
        "segunda",
        "terca",
        "quarta",
        "quinta",
        "sexta",
        "sabado",
        "domingo"
      ],
      "description": "Dia da semana (tipos semanal, diario, fim_de_semana)"
    },
    "refeicao": {
      "type": "string",
      "enum": [
        "cafe_da_manha",
        "almoco",
        "lanche",
        "jantar"
      ],
      "description": "Refei\u00e7\u00e3o (tipos semanal, diario, fim_de_semana)"
    }
  },
  "required": [
    "cardapio_id"
  ]
}