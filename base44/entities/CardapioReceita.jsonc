{
  "name": "CardapioReceita",
  "type": "object",
  "properties": {
    "cardapio_id": {
      "type": "string",
      "description": "ID do cardápio"
    },
    "receita_id": {
      "type": "string",
      "description": "ID da receita"
    },
    "receita_nome": {
      "type": "string",
      "description": "Nome da receita (cache)"
    },
    "receita_categoria": {
      "type": "string",
      "description": "Categoria da receita (cache)"
    },
    "per_capita_g": {
      "type": "number",
      "description": "Quantidade per capita em gramas (ou kg para buffet)"
    },
    "quantidade_total_g": {
      "type": "number",
      "description": "Quantidade total calculada (g ou kg conforme tipo)"
    },
    "custo_total": {
      "type": "number",
      "description": "Custo total calculado da receita no cardápio"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem de exibição"
    },
    "dia_semana": {
      "type": "string",
      "enum": [
        "segunda",
        "terca",
        "quarta",
        "quinta",
        "sexta",
        "sabado",
        "domingo"
      ],
      "description": "Dia da semana (tipos semanal, diario, fim_de_semana)"
    },
    "refeicao": {
      "type": "string",
      "enum": [
        "cafe_da_manha",
        "almoco",
        "lanche",
        "jantar"
      ],
      "description": "Refeição (tipos semanal, diario, fim_de_semana)"
    },
    "is_base": {
      "type": "boolean",
      "description": "Espelha se o cardápio-pai pertence ao catálogo-base compartilhado"
    },
    "usuario_dono_id": {
      "type": "string",
      "description": "ID do usuário dono quando o cardápio-pai é uma cópia pessoal"
    }
  },
  "required": [
    "cardapio_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.is_base": false
            },
            {
              "data.usuario_dono_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.is_base": true
        },
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
