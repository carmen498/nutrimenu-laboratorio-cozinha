{
  "name": "LogEmail",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string",
      "description": "ID t\u00e9cnico do usu\u00e1rio destinat\u00e1rio, quando dispon\u00edvel; usado para deduplica\u00e7\u00e3o sem depender do contato em claro"
    },
    "destinatario_email": {
      "type": "string",
      "description": "E-mail mascarado do destinat\u00e1rio (ex.: ca***@dominio.com); novos registros n\u00e3o persistem o endere\u00e7o completo"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "boas_vindas",
        "trial_expirando",
        "trial_vencido",
        "pagamento_aprovado",
        "pagamento_recusado",
        "pagamento_estornado",
        "plano_vencendo",
        "pagamento_pendente_lembrete",
        "onboarding_dia2",
        "onboarding_dia5",
        "onboarding_resumo_oferta",
        "reativacao_d3",
        "reativacao_d7"
      ],
      "description": "Tipo do e-mail transacional disparado"
    },
    "enviado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do envio"
    },
    "status": {
      "type": "string",
      "enum": [
        "enviado",
        "falhou"
      ],
      "default": "enviado",
      "description": "Status do envio"
    },
    "detalhe_erro": {
      "type": "string",
      "description": "Resumo sanitizado do erro de envio, sem payload bruto, token, e-mail ou telefone"
    }
  },
  "required": [
    "destinatario_email",
    "tipo",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}