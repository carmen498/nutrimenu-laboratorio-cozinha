{
  "name": "LogEmail",
  "type": "object",
  "properties": {
    "destinatario_email": {
      "type": "string",
      "description": "E-mail do destinat\u00e1rio"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "boas_vindas",
        "trial_expirando",
        "trial_vencido",
        "pagamento_aprovado",
        "pagamento_recusado",
        "pagamento_estornado",
        "plano_vencendo",
        "pagamento_pendente_lembrete"
      ],
      "description": "Tipo do e-mail transacional disparado"
    },
    "enviado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do envio"
    },
    "status": {
      "type": "string",
      "enum": [
        "enviado",
        "falhou"
      ],
      "default": "enviado",
      "description": "Status do envio"
    },
    "detalhe_erro": {
      "type": "string",
      "description": "Mensagem de erro completa retornada pelo Resend quando o envio falha (c\u00f3digo HTTP + corpo da resposta), para diagn\u00f3stico"
    }
  },
  "required": [
    "destinatario_email",
    "tipo",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}