{
  "name": "LogExclusaoUsuario",
  "type": "object",
  "properties": {
    "usuario_excluido_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio exclu\u00eddo"
    },
    "usuario_excluido_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio exclu\u00eddo no momento da exclus\u00e3o (cache para auditoria)"
    },
    "usuario_excluido_email": {
      "type": "string",
      "description": "E-mail do usu\u00e1rio exclu\u00eddo no momento da exclus\u00e3o (cache para auditoria)"
    },
    "excluido_por_id": {
      "type": "string",
      "description": "ID do administrador que executou a exclus\u00e3o"
    },
    "excluido_por_nome": {
      "type": "string",
      "description": "Nome do administrador que executou a exclus\u00e3o"
    },
    "excluido_por_email": {
      "type": "string",
      "description": "E-mail do administrador que executou a exclus\u00e3o"
    },
    "pagamentos_apagados": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de registros de pagamento apagados"
    },
    "acessos_apagados": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de acessos (Guia ZR + Laborat\u00f3rio de Custos) apagados"
    },
    "logs_email_apagados": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de logs de e-mail apagados"
    },
    "receitas_apagadas": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de receitas pessoais apagadas"
    },
    "cardapios_apagados": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de card\u00e1pios pessoais apagados"
    },
    "eventos_apagados": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de eventos/planejamentos apagados"
    },
    "fichas_apagadas": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de fichas de c\u00e1lculo de custo apagadas"
    }
  },
  "required": [
    "usuario_excluido_id",
    "usuario_excluido_email",
    "excluido_por_id",
    "excluido_por_email"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": false,
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}