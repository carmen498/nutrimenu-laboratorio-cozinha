{
  "name": "AtualizacaoLotePrecosLog",
  "type": "object",
  "properties": {
    "data_execucao": { "type": "string", "format": "date-time", "description": "Data/hora da execução do lote" },
    "total_atualizado": { "type": "number", "description": "Total de ingredientes atualizados" },
    "total_pulado": { "type": "number", "description": "Total de ingredientes pulados (já tinham preço ou sem peso de embalagem)" },
    "total_nao_localizado": { "type": "number", "description": "Total de nomes da lista não encontrados na base" },
    "atualizados": {
      "type": "array",
      "description": "Itens atualizados com preço antes/depois",
      "items": {
        "type": "object",
        "properties": {
          "nome": { "type": "string" },
          "preco_embalagem_antes": { "type": "number" },
          "preco_embalagem_depois": { "type": "number" },
          "preco_por_g_antes": { "type": "number" },
          "preco_por_g_depois": { "type": "number" }
        }
      }
    },
    "pulados": {
      "type": "array",
      "description": "Itens pulados por já terem preço ou por falta de peso de embalagem",
      "items": {
        "type": "object",
        "properties": { "nome": { "type": "string" }, "motivo": { "type": "string" } }
      }
    },
    "nao_localizados": {
      "type": "array",
      "description": "Nomes da lista não encontrados na base de ingredientes",
      "items": { "type": "string" }
    }
  },
  "required": ["data_execucao"],
  "rls": {
    "read": { "user_condition": { "role": "admin" } },
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}