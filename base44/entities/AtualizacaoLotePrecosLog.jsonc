{
  "name": "AtualizacaoLotePrecosLog",
  "type": "object",
  "properties": {
    "data_execucao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da execu\u00e7\u00e3o do lote"
    },
    "total_atualizado": {
      "type": "number",
      "description": "Total de ingredientes atualizados"
    },
    "total_pulado": {
      "type": "number",
      "description": "Total de ingredientes pulados (j\u00e1 tinham pre\u00e7o ou sem peso de embalagem)"
    },
    "total_nao_localizado": {
      "type": "number",
      "description": "Total de nomes da lista n\u00e3o encontrados na base"
    },
    "atualizados": {
      "type": "array",
      "description": "Itens atualizados com pre\u00e7o antes/depois",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "preco_embalagem_antes": {
            "type": "number"
          },
          "preco_embalagem_depois": {
            "type": "number"
          },
          "preco_por_g_antes": {
            "type": "number"
          },
          "preco_por_g_depois": {
            "type": "number"
          }
        }
      }
    },
    "pulados": {
      "type": "array",
      "description": "Itens pulados por j\u00e1 terem pre\u00e7o ou por falta de peso de embalagem",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "motivo": {
            "type": "string"
          }
        }
      }
    },
    "nao_localizados": {
      "type": "array",
      "description": "Nomes da lista n\u00e3o encontrados na base de ingredientes",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "data_execucao"
  ]
}