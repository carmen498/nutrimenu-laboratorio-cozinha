{
  "name": "PreenchimentoPerCapitaLog",
  "type": "object",
  "properties": {
    "data_execucao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da execu\u00e7\u00e3o do lote"
    },
    "total_processado": {
      "type": "number",
      "description": "Total de receitas encontradas sem per_capita_g nesta execu\u00e7\u00e3o"
    },
    "total_aplicado": {
      "type": "number",
      "description": "Total de receitas que receberam PC padr\u00e3o"
    },
    "total_sem_categoria_definida": {
      "type": "number",
      "description": "Total de receitas cuja categoria principal n\u00e3o consta na tabela de PC padr\u00e3o"
    },
    "aplicados": {
      "type": "array",
      "description": "Receitas atualizadas com PC padr\u00e3o",
      "items": {
        "type": "object",
        "properties": {
          "receita_id": {
            "type": "string"
          },
          "receita_nome": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          },
          "pc_aplicado": {
            "type": "number"
          }
        }
      }
    },
    "sem_categoria_definida": {
      "type": "array",
      "description": "Receitas n\u00e3o alteradas por falta de PC padr\u00e3o definido para a categoria",
      "items": {
        "type": "object",
        "properties": {
          "receita_id": {
            "type": "string"
          },
          "receita_nome": {
            "type": "string"
          },
          "categoria": {
            "type": "string"
          }
        }
      }
    },
    "resumo_por_categoria": {
      "type": "array",
      "description": "Totais aplicados agrupados por categoria",
      "items": {
        "type": "object",
        "properties": {
          "categoria": {
            "type": "string"
          },
          "pc_aplicado": {
            "type": "number"
          },
          "quantidade": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "data_execucao"
  ]
}