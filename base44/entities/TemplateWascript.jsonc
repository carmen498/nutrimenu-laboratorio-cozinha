{
  "name": "TemplateWascript",
  "type": "object",
  "properties": {
    "tipo": {
      "type": "string",
      "enum": [
        "pagamento_aprovado",
        "pagamento_recusado",
        "plano_vencendo",
        "pagamento_pendente_lembrete",
        "pagamento_estornado",
        "reativacao_alto_uso"
      ],
      "description": "Tipo do evento transacional ao qual esta mensagem de WhatsApp pertence"
    },
    "texto": {
      "type": "string",
      "description": "Texto da mensagem de WhatsApp. Pode conter a vari\u00e1vel {{nome}}"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "ativo"
      ],
      "default": "rascunho",
      "description": "Status da mensagem: rascunho (n\u00e3o \u00e9 disparada) ou ativo (disparada normalmente)"
    }
  },
  "required": [
    "tipo",
    "texto"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}