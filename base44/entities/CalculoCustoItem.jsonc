{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio dono do item; definido server-side."
    },
    "calculo_id": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "ingredientes",
        "embalagem",
        "mao_obra",
        "despesa_rateada",
        "imposto",
        "taxa_cartao",
        "comissao",
        "perda",
        "outro"
      ]
    },
    "descricao": {
      "type": "string"
    },
    "origem": {
      "type": "string"
    },
    "formula": {
      "type": "string"
    },
    "quantidade": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "valor_unitario": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "valor_total": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "ordem": {
      "type": "number",
      "default": 0
    },
    "snapshot_detalhes": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "calculo_id",
    "tipo",
    "descricao"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "CalculoCustoItem"
}