{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio dono do item; seguran\u00e7a efetiva baseada em created_by_id."
    },
    "calculo_id": {
      "type": "string",
      "description": "ID do CalculoCusto pai."
    },
    "tipo": {
      "type": "string",
      "enum": [
        "ingredientes",
        "embalagem",
        "mao_obra",
        "despesa_rateada",
        "imposto",
        "taxa_cartao",
        "comissao",
        "perda",
        "outro"
      ],
      "description": "Tipo do componente de custo."
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o exibida na composi\u00e7\u00e3o da ficha."
    },
    "origem": {
      "type": "string",
      "description": "Origem/justificativa do valor (receita, despesa mensal, informado na produ\u00e7\u00e3o etc.)."
    },
    "formula": {
      "type": "string",
      "description": "Explica\u00e7\u00e3o leg\u00edvel de como o valor foi calculado."
    },
    "quantidade": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "valor_unitario": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "valor_total": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "ordem": {
      "type": "number",
      "default": 0
    },
    "snapshot_detalhes": {
      "type": "string",
      "description": "Snapshot textual opcional de detalhes necess\u00e1rios para auditoria futura."
    }
  },
  "required": [
    "user_id",
    "calculo_id",
    "tipo",
    "descricao"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "name": "CalculoCustoItem"
}