{
  "name": "HistoricoAlteracaoReceita",
  "type": "object",
  "properties": {
    "receita_id": {
      "type": "string",
      "description": "ID da receita alterada"
    },
    "receita_nome": {
      "type": "string",
      "description": "Nome da receita no momento da altera\u00e7\u00e3o (cache)"
    },
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio respons\u00e1vel pela altera\u00e7\u00e3o; usado para leitura do pr\u00f3prio hist\u00f3rico"
    },
    "usuario_nome": {
      "type": "string",
      "description": "Nome do usu\u00e1rio respons\u00e1vel pela altera\u00e7\u00e3o, quando identific\u00e1vel"
    },
    "campos_alterados": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Lista de campos/\u00e1reas alteradas (ex: Nome, Modo de preparo, Ingredientes)"
    }
  },
  "required": [
    "receita_id"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.usuario_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}