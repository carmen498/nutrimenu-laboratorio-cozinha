{
  "name": "AppConfig",
  "type": "object",
  "properties": {
    "chave": {
      "type": "string",
      "description": "Chave de configura\u00e7\u00e3o"
    },
    "valor": {
      "type": "string",
      "description": "Valor da configura\u00e7\u00e3o"
    }
  },
  "required": [
    "chave"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}