{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio titular do add-on Laborat\u00f3rio de Custos."
    },
    "modulo": {
      "type": "string",
      "enum": [
        "laboratorio_custos"
      ],
      "default": "laboratorio_custos",
      "description": "M\u00f3dulo concedido por este entitlement."
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "ativo",
        "suspenso",
        "cancelado",
        "expirado"
      ],
      "default": "pendente",
      "description": "Estado persistido do acesso. A validade temporal tamb\u00e9m \u00e9 conferida por inicio_em/fim_em."
    },
    "modalidade": {
      "type": "string",
      "enum": [
        "trial",
        "30_dias",
        "anual",
        "cortesia",
        "admin",
        "migracao"
      ],
      "description": "Modalidade comercial ou administrativa que originou o acesso."
    },
    "plano_id": {
      "type": "string",
      "enum": [
        "custos_trial",
        "custos_mensal",
        "custos_anual"
      ],
      "description": "Oferta do Laborat\u00f3rio de Custos relacionada ao acesso, quando aplic\u00e1vel."
    },
    "origem": {
      "type": "string",
      "enum": [
        "admin",
        "checkout",
        "cortesia",
        "migracao",
        "trial"
      ],
      "default": "admin",
      "description": "Origem da concess\u00e3o do entitlement."
    },
    "inicio_em": {
      "type": "string",
      "format": "date-time",
      "description": "In\u00edcio da validade do acesso."
    },
    "fim_em": {
      "type": "string",
      "format": "date-time",
      "description": "Fim opcional da validade do acesso."
    },
    "trial_ativado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que o trial \u00fanico de 7 dias foi ativado."
    },
    "oferta_versao": {
      "type": "string",
      "description": "Vers\u00e3o da oferta que originou o acesso, para rastreabilidade."
    },
    "cancelado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do cancelamento, quando aplic\u00e1vel."
    },
    "referencia_pagamento_id": {
      "type": "string",
      "description": "Pagamento do add-on que concedeu este acesso, quando houver checkout integrado."
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o administrativa sobre a concess\u00e3o/cancelamento."
    }
  },
  "required": [
    "user_id",
    "modulo",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "AcessoLaboratorioCustosUsuario"
}