{
  "name": "IngredienteUsuario",
  "type": "object",
  "properties": {
    "ingrediente_id": {
      "type": "string",
      "description": "ID do Ingrediente mestre ao qual estes dados pessoais pertencem"
    },
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio dono do registro (cache; a seguran\u00e7a usa created_by_id)"
    },
    "favorito": {
      "type": "boolean",
      "default": false,
      "description": "Ingrediente marcado como favorito apenas para este usu\u00e1rio"
    },
    "unidade_compra": {
      "type": "string",
      "description": "Unidade em que este usu\u00e1rio compra o ingrediente (KG, LT, UN, CX, POTE...)"
    },
    "peso_embalagem_g": {
      "type": "number",
      "description": "Quantidade da embalagem comprada por este usu\u00e1rio, em g ou ml"
    },
    "preco_embalagem_rs": {
      "type": "number",
      "description": "Pre\u00e7o pago por este usu\u00e1rio pela embalagem, em R$"
    },
    "preco_por_g_rs": {
      "type": "number",
      "description": "Pre\u00e7o pessoal por g/ml, calculado a partir da embalagem"
    },
    "fornecedor": {
      "type": "string",
      "description": "Fornecedor utilizado por este usu\u00e1rio"
    },
    "estado_usuario": {
      "type": "string",
      "description": "UF/estado associado aos dados de compra deste usu\u00e1rio"
    },
    "fonte_preco": {
      "type": "string",
      "enum": [
        "Manual",
        "IA web",
        "CONAB",
        "CEASA"
      ],
      "description": "Fonte da \u00faltima atualiza\u00e7\u00e3o do pre\u00e7o pessoal"
    },
    "preco_atualizado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da \u00faltima altera\u00e7\u00e3o do pre\u00e7o pessoal"
    },
    "variacao_percentual": {
      "type": "number",
      "description": "Varia\u00e7\u00e3o percentual do pre\u00e7o pessoal em rela\u00e7\u00e3o ao registro anterior"
    },
    "historico_precos": {
      "type": "array",
      "description": "Hist\u00f3rico de pre\u00e7os deste usu\u00e1rio para o ingrediente",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date-time"
          },
          "preco_por_kg": {
            "type": "number"
          },
          "variacao_percentual": {
            "type": "number"
          },
          "fonte": {
            "type": "string"
          },
          "fornecedor": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "ingrediente_id",
    "user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}