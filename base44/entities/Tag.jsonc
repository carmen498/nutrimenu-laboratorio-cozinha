{
  "name": "Tag",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da tag"
    },
    "grupo": {
      "type": "string",
      "enum": [
        "molho",
        "ingrediente",
        "perfil",
        "restricao",
        "metodo",
        "contexto"
      ],
      "description": "Grupo da tag para organiza\u00e7\u00e3o"
    },
    "cor": {
      "type": "string",
      "enum": [
        "verde",
        "vermelho",
        "cinza",
        "verde-claro"
      ],
      "description": "Cor do badge"
    }
  },
  "required": [
    "nome",
    "grupo"
  ]
}