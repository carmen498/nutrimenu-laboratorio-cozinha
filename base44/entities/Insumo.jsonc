{
  "name": "Insumo",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do insumo"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "material",
        "embalagem"
      ],
      "description": "Categoria: material de uso direto ou embalagem"
    },
    "unidade": {
      "type": "string",
      "description": "Unidade de medida (Folha, Cm, Metro, Unidade, Pacote, etc.)"
    },
    "preco_embalagem": {
      "type": "number",
      "description": "Pre\u00e7o pago pela embalagem/pacote comprado (R$)"
    },
    "quantidade_embalagem": {
      "type": "number",
      "description": "Quantidade total de unidades de medida contida na embalagem comprada (ex: 50 folhas)"
    },
    "preco_unitario": {
      "type": "number",
      "description": "Pre\u00e7o por unidade de medida em R$ \u2014 calculado automaticamente (preco_embalagem / quantidade_embalagem), mas pode ser ajustado manualmente"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}