{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio dono do c\u00e1lculo; seguran\u00e7a efetiva baseada em created_by_id."
    },
    "tipo_origem": {
      "type": "string",
      "enum": [
        "receita",
        "cardapio"
      ],
      "default": "receita",
      "description": "Tipo da origem do c\u00e1lculo."
    },
    "origem_id": {
      "type": "string",
      "description": "ID da Receita ou Card\u00e1pio usado como origem."
    },
    "origem_nome_snapshot": {
      "type": "string",
      "description": "Nome congelado da origem no momento do c\u00e1lculo."
    },
    "origem_versao_snapshot": {
      "type": "string",
      "description": "Vers\u00e3o/identificador textual da origem no momento do c\u00e1lculo."
    },
    "categoria_snapshot": {
      "type": "string",
      "description": "Categoria exibida na ficha, congelada no momento do c\u00e1lculo."
    },
    "foto_url_snapshot": {
      "type": "string",
      "description": "URL da foto exibida na ficha no momento do c\u00e1lculo."
    },
    "quantidade_produzida": {
      "type": "number",
      "minimum": 0,
      "description": "Quantidade total planejada para esta produ\u00e7\u00e3o."
    },
    "unidade_producao": {
      "type": "string",
      "description": "Unidade principal da produ\u00e7\u00e3o (bolos, unidades, kg etc.)."
    },
    "rendimento_snapshot": {
      "type": "number",
      "minimum": 0,
      "description": "Rendimento num\u00e9rico da origem no momento do c\u00e1lculo."
    },
    "rendimento_unidade_snapshot": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o/unidade do rendimento congelada no momento do c\u00e1lculo."
    },
    "custo_ingredientes_snapshot": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "custo_embalagens": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "custo_mao_obra": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "custo_rateado": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "custo_total": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "custo_unitario": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "custo_por_porcao": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "preco_venda_informado": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "markup_aplicado": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "preco_sugerido": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "margem_estimada": {
      "type": "number",
      "default": 0,
      "description": "Margem percentual estimada no momento do c\u00e1lculo."
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o pessoal da ficha de custo."
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado",
        "recalculado"
      ],
      "default": "rascunho"
    },
    "data_calculo": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora l\u00f3gica do c\u00e1lculo."
    },
    "versao_calculo": {
      "type": "number",
      "minimum": 1,
      "default": 1,
      "description": "Vers\u00e3o hist\u00f3rica do c\u00e1lculo."
    },
    "calculo_origem_id": {
      "type": "string",
      "description": "ID do c\u00e1lculo anterior quando esta ficha foi duplicada/recalculada."
    }
  },
  "required": [
    "user_id",
    "tipo_origem",
    "origem_id",
    "origem_nome_snapshot"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "name": "CalculoCusto"
}