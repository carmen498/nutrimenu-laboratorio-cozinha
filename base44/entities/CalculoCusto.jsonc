{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio dono do c\u00e1lculo; definido e validado server-side."
    },
    "tipo_origem": {
      "type": "string",
      "enum": [
        "receita",
        "cardapio"
      ],
      "default": "receita"
    },
    "origem_id": {
      "type": "string"
    },
    "origem_nome_snapshot": {
      "type": "string"
    },
    "origem_versao_snapshot": {
      "type": "string"
    },
    "categoria_snapshot": {
      "type": "string"
    },
    "foto_url_snapshot": {
      "type": "string"
    },
    "quantidade_produzida": {
      "type": "number",
      "minimum": 0
    },
    "unidade_producao": {
      "type": "string"
    },
    "rendimento_snapshot": {
      "type": "number",
      "minimum": 0
    },
    "rendimento_unidade_snapshot": {
      "type": "string"
    },
    "total_porcoes_snapshot": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "modelo_tecnico_versao": {
      "type": "number",
      "minimum": 1
    },
    "custo_ingredientes_snapshot": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "custo_insumos_tecnicos_snapshot": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "custo_esquecidos_snapshot": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "custo_tecnico_snapshot": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "custo_embalagens": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "custo_mao_obra": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "custo_rateado": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "custo_total": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "custo_unitario": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "custo_por_porcao": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "preco_venda_informado": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "markup_aplicado": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "preco_sugerido": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "margem_estimada": {
      "type": "number",
      "default": 0
    },
    "formacao_preco_metodo": {
      "type": "string",
      "enum": [
        "informado",
        "margem"
      ],
      "default": "informado"
    },
    "margem_desejada_pct": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "taxa_cartao_pct": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "impostos_pct": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "taxas_variaveis_pct": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "custo_fixo_adicional_unitario": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "observacao": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "finalizado",
        "recalculado"
      ],
      "default": "rascunho"
    },
    "data_calculo": {
      "type": "string",
      "format": "date-time"
    },
    "versao_calculo": {
      "type": "number",
      "minimum": 1,
      "default": 1
    },
    "calculo_origem_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "tipo_origem",
    "origem_id",
    "origem_nome_snapshot"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "CalculoCusto"
}