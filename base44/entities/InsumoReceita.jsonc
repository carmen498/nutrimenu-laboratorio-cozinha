{
  "name": "InsumoReceita",
  "type": "object",
  "properties": {
    "receita_id": {
      "type": "string",
      "description": "ID da receita"
    },
    "insumo_id": {
      "type": "string",
      "description": "ID do insumo no banco"
    },
    "insumo_nome": {
      "type": "string",
      "description": "Nome do insumo (cache)"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "material",
        "embalagem"
      ],
      "description": "Categoria do insumo"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade usada por lote"
    },
    "unidade": {
      "type": "string",
      "description": "Unidade de medida usada"
    },
    "custo_unitario": {
      "type": "number",
      "description": "Custo unit\u00e1rio edit\u00e1vel (R$)"
    },
    "custo_total": {
      "type": "number",
      "description": "Cache do custo na escala-base cadastrada; o custo escalado \u00e9 derivado pelo motor can\u00f4nico"
    },
    "comportamento_custo": {
      "type": "string",
      "enum": [
        "por_lote",
        "proporcional",
        "por_unidade"
      ],
      "default": "por_lote",
      "description": "por_lote = custo fixo por execu\u00e7\u00e3o; proporcional = acompanha o fator da receita; por_unidade = quantidade cadastrada por unidade final/por\u00e7\u00e3o"
    },
    "modelo_custo_versao": {
      "type": "number",
      "default": 2,
      "description": "Vers\u00e3o da sem\u00e2ntica can\u00f4nica de escalonamento do insumo"
    },
    "is_base": {
      "type": "boolean",
      "description": "Espelha se o receita-pai pertence ao cat\u00e1logo-base compartilhado"
    },
    "usuario_dono_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio dono quando o receita-pai \u00e9 uma c\u00f3pia pessoal"
    }
  },
  "required": [
    "receita_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.is_base": false
            },
            {
              "data.usuario_dono_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.is_base": true
        },
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}