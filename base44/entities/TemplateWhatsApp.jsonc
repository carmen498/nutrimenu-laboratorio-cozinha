{
  "name": "TemplateWhatsApp",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do template (refer\u00eancia usada ao cadastrar no To Talk)"
    },
    "cabecalho_url": {
      "type": "string",
      "description": "URL da imagem de cabe\u00e7alho do template"
    },
    "corpo": {
      "type": "string",
      "description": "Corpo da mensagem, pode conter a vari\u00e1vel {{nome}}"
    },
    "rodape": {
      "type": "string",
      "description": "Rodap\u00e9 fixo opcional"
    },
    "status_aprovacao": {
      "type": "string",
      "enum": [
        "Aguardando envio",
        "Aguardando aprova\u00e7\u00e3o da Meta",
        "Aprovado",
        "Rejeitado"
      ],
      "default": "Aguardando envio",
      "description": "Status de aprova\u00e7\u00e3o do template no To Talk/Meta, atualizado manualmente"
    }
  },
  "required": [
    "nome",
    "corpo"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}