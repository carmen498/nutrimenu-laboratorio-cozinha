{
  "name": "LogRetencaoDados",
  "type": "object",
  "properties": {
    "executado_em": {
      "type": "string",
      "format": "date-time"
    },
    "executado_por_id": {
      "type": "string"
    },
    "modo": {
      "type": "string",
      "enum": [
        "simular",
        "aplicar"
      ]
    },
    "versao_politica": {
      "type": "string"
    },
    "total_excluido": {
      "type": "number"
    },
    "total_minimizado": {
      "type": "number"
    },
    "resultados_json": {
      "type": "string",
      "description": "Resumo t\u00e9cnico agregado da execu\u00e7\u00e3o; n\u00e3o cont\u00e9m e-mail, telefone, payload de provedor ou conte\u00fado de mensagem"
    }
  },
  "required": [
    "executado_em",
    "modo",
    "versao_politica"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}