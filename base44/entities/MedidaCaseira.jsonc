{
  "name": "MedidaCaseira",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da medida (ex: X\u00edcara (ch\u00e1), Colher (sopa))"
    },
    "ingrediente_especifico": {
      "type": "string",
      "description": "Nome do ingrediente espec\u00edfico (vazio = padr\u00e3o geral)"
    },
    "equivalencia_g": {
      "type": "number",
      "description": "Equival\u00eancia em gramas"
    },
    "equivalencia_ml": {
      "type": "number",
      "description": "Equival\u00eancia em ml (para l\u00edquidos)"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da medida"
    },
    "alimento": {
      "type": "string",
      "description": "ID do Ingrediente de refer\u00eancia (alimento ao qual a medida se aplica)"
    },
    "utensilio": {
      "type": "string",
      "description": "ID do UtensilioPadrao de refer\u00eancia"
    },
    "referencia_g": {
      "type": "number",
      "description": "Gramas de 1 medida do alimento CRU"
    },
    "medida_pronto_g": {
      "type": "number",
      "description": "Gramas de 1 medida do alimento SERVIDO/PRONTO (opcional)"
    },
    "so_gramas": {
      "type": "boolean",
      "default": false,
      "description": "Quando true, o conversor nunca exibe medida caseira para este alimento (apenas gramas)"
    }
  },
  "required": [
    "nome"
  ]
}