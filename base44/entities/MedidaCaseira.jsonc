{
  "name": "MedidaCaseira",
  "type": "object",
  "properties": {
    "modelo_versao": {
      "type": "number",
      "description": "Vers\u00e3o do modelo. Novos registros normalizados usam 2; aus\u00eancia/1 identifica legado."
    },
    "nome": {
      "type": "string",
      "description": "R\u00f3tulo de exibi\u00e7\u00e3o da equival\u00eancia. N\u00e3o \u00e9 identidade; as refer\u00eancias can\u00f4nicas s\u00e3o ingrediente_id + utensilio_id + estado_alimento."
    },
    "chave_canonica": {
      "type": "string",
      "description": "Chave derivada ingrediente_id|utensilio_id|estado_alimento para diagn\u00f3stico e preven\u00e7\u00e3o de duplicidades."
    },
    "ingrediente_id": {
      "type": "string",
      "description": "ID can\u00f4nico do Ingrediente ao qual a equival\u00eancia se aplica."
    },
    "utensilio_id": {
      "type": "string",
      "description": "ID can\u00f4nico do UtensilioPadrao."
    },
    "quantidade_utensilio": {
      "type": "number",
      "default": 1,
      "description": "Quantidade do utens\u00edlio correspondente a peso_g/volume_ml. Ex.: 2 x\u00edcaras = 240 g."
    },
    "peso_g": {
      "type": "number",
      "description": "Peso em gramas correspondente a quantidade_utensilio no estado informado."
    },
    "volume_ml": {
      "type": "number",
      "description": "Volume em ml correspondente a quantidade_utensilio, quando aplic\u00e1vel."
    },
    "estado_alimento": {
      "type": "string",
      "enum": [
        "cru",
        "pronto",
        "n\u00e3o informado"
      ],
      "default": "n\u00e3o informado",
      "description": "Estado f\u00edsico da equival\u00eancia. Medidas de alimento cru e pronto s\u00e3o registros distintos."
    },
    "fonte": {
      "type": "string",
      "description": "Fonte da equival\u00eancia: medi\u00e7\u00e3o pr\u00f3pria, tabela, fabricante, literatura, importa\u00e7\u00e3o etc."
    },
    "so_gramas": {
      "type": "boolean",
      "default": false,
      "description": "Quando true, o conversor n\u00e3o exibe medida caseira para este alimento e mant\u00e9m apenas g/ml."
    },
    "descricao": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o livre sobre a equival\u00eancia."
    },
    "ingrediente_especifico": {
      "type": "string",
      "description": "LEGADO: nome textual do ingrediente. N\u00e3o usar em novas grava\u00e7\u00f5es."
    },
    "equivalencia_g": {
      "type": "number",
      "description": "LEGADO: equival\u00eancia em gramas. Leitura compat\u00edvel; novas grava\u00e7\u00f5es usam peso_g."
    },
    "equivalencia_ml": {
      "type": "number",
      "description": "LEGADO: equival\u00eancia em ml. Leitura compat\u00edvel; novas grava\u00e7\u00f5es usam volume_ml."
    },
    "alimento": {
      "type": "string",
      "description": "LEGADO: ID do Ingrediente. Leitura compat\u00edvel; novas grava\u00e7\u00f5es usam ingrediente_id."
    },
    "utensilio": {
      "type": "string",
      "description": "LEGADO: ID do UtensilioPadrao. Leitura compat\u00edvel; novas grava\u00e7\u00f5es usam utensilio_id."
    },
    "referencia_g": {
      "type": "number",
      "description": "LEGADO/CACHE TEMPOR\u00c1RIO: gramas por 1 medida. Mantido enquanto consumidores antigos s\u00e3o retirados; peso_g \u00e9 a fonte can\u00f4nica."
    },
    "medida_pronto_g": {
      "type": "number",
      "description": "LEGADO: equival\u00eancia de alimento pronto armazenada no mesmo registro. Deve ser revisada e separada em registro estado_alimento=pronto."
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}