{
  "name": "IngredienteReceita",
  "type": "object",
  "properties": {
    "receita_id": {
      "type": "string",
      "description": "ID da receita"
    },
    "ingrediente_id": {
      "type": "string",
      "description": "ID do ingrediente (vazio para tipo=grupo ou tipo=subreceita)"
    },
    "ingrediente_nome": {
      "type": "string",
      "description": "Nome do ingrediente (cache)"
    },
    "pre_preparo": {
      "type": "string",
      "description": "Pr\u00e9-preparo (picado, em cubos, desfiado)"
    },
    "quantidade_por_porcao": {
      "type": "number",
      "description": "Quantidade por por\u00e7\u00e3o em g/ml"
    },
    "medida_caseira": {
      "type": "string",
      "description": "Medida caseira usada (ex: 1 x\u00edcara)"
    },
    "ordem": {
      "type": "number",
      "description": "Ordem de exibi\u00e7\u00e3o"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "ingrediente",
        "grupo",
        "subreceita"
      ],
      "default": "ingrediente",
      "description": "Tipo do item na lista: ingrediente, grupo ou subreceita"
    },
    "titulo_grupo": {
      "type": "string",
      "description": "T\u00edtulo do grupo (usado quando tipo=grupo)"
    },
    "subreceita_id": {
      "type": "string",
      "description": "ID da receita usada como sub-receita (quando tipo=subreceita)"
    },
    "subreceita_nome": {
      "type": "string",
      "description": "Nome da sub-receita (cache)"
    },
    "subreceita_parent_id": {
      "type": "string",
      "description": "ID do item subreceita pai (para ingredientes explodidos de sub-receitas \u2014 agrupamento visual e exclus\u00e3o em cascata)"
    },
    "proporcional": {
      "type": "boolean",
      "default": true,
      "description": "Indica se o ingrediente escala proporcionalmente com a receita (true) ou tem quantidade fixa (false)"
    }
  },
  "required": [
    "receita_id"
  ]
}