{
  "name": "IngredienteReceita",
  "type": "object",
  "properties": {
    "receita_id": {
      "type": "string",
      "description": "ID da receita"
    },
    "ingrediente_id": {
      "type": "string",
      "description": "ID do ingrediente (vazio para tipo=grupo ou tipo=subreceita)"
    },
    "ingrediente_nome": {
      "type": "string",
      "description": "LEGADO/CACHE: nome do ingrediente. A identidade canônica é ingrediente_id."
    },
    "pre_preparo": {
      "type": "string",
      "description": "Pré-preparo específico deste ingrediente nesta receita (picado, em cubos, desfiado...)"
    },
    "quantidade_por_porcao": {
      "type": "number",
      "description": "Quantidade líquida por porção. A unidade é definida em unidade_quantidade; legado assume g/ml conforme a receita."
    },
    "unidade_quantidade": {
      "type": "string",
      "enum": ["g", "ml"],
      "description": "Unidade canônica da quantidade deste item. Quando ausente, usa receita.unidade_base como compatibilidade."
    },
    "fator_correcao_override": {
      "type": "number",
      "description": "FC específico deste ingrediente nesta receita. Valor > 0 prevalece sobre Ingrediente.fator_correcao; 0/ausente significa usar o padrão do ingrediente."
    },
    "medida_caseira_id": {
      "type": "string",
      "description": "ID da MedidaCaseira escolhida especificamente para este item da receita. Quando ausente, o app pode usar a medida padrão do ingrediente."
    },
    "quantidade_medida_caseira": {
      "type": "number",
      "description": "Quantidade de medidas informada pelo usuário quando a quantidade do item foi digitada em medida caseira. É metadado de entrada; os gramas/ml continuam sendo a base de cálculo."
    },
    "medida_caseira": {
      "type": "string",
      "description": "LEGADO/CACHE: texto livre de medida caseira. Novas relações devem usar medida_caseira_id."
    },
    "ordem": {
      "type": "number",
      "description": "Ordem de exibição"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "ingrediente",
        "grupo",
        "subreceita"
      ],
      "default": "ingrediente",
      "description": "Tipo do item na lista: ingrediente, grupo ou subreceita"
    },
    "titulo_grupo": {
      "type": "string",
      "description": "Título do grupo (usado quando tipo=grupo)"
    },
    "subreceita_id": {
      "type": "string",
      "description": "ID da receita usada como sub-receita (quando tipo=subreceita)"
    },
    "subreceita_nome": {
      "type": "string",
      "description": "LEGADO/CACHE: nome da sub-receita. A relação canônica é subreceita_id."
    },
    "subreceita_parent_id": {
      "type": "string",
      "description": "ID do item subreceita pai (para ingredientes explodidos de sub-receitas — agrupamento visual e exclusão em cascata)"
    },
    "proporcional": {
      "type": "boolean",
      "default": true,
      "description": "Indica se o ingrediente escala proporcionalmente com a receita (true) ou tem quantidade fixa (false)"
    },
    "is_base": {
      "type": "boolean",
      "description": "Espelha se a receita-pai pertence ao catálogo-base compartilhado"
    },
    "usuario_dono_id": {
      "type": "string",
      "description": "ID do usuário dono quando a receita-pai é uma cópia pessoal"
    }
  },
  "required": [
    "receita_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.is_base": false
            },
            {
              "data.usuario_dono_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.is_base": true
        },
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
