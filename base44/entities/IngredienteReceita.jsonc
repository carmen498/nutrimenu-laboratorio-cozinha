{
  "name": "IngredienteReceita",
  "type": "object",
  "properties": {
    "receita_id": {
      "type": "string",
      "description": "ID da receita"
    },
    "modelo_versao": {
      "type": "number",
      "description": "Versão do modelo de composição. Novos registros normalizados usam 2; ausência/1 identifica registros legados a migrar."
    },
    "ingrediente_id": {
      "type": "string",
      "description": "Referência canônica ao Ingrediente quando tipo=ingrediente. Vazio nos demais tipos."
    },
    "ingrediente_nome": {
      "type": "string",
      "description": "LEGADO/CACHE de exibição. Não usar como identidade; o nome canônico deve ser resolvido por ingrediente_id."
    },
    "pre_preparo": {
      "type": "string",
      "description": "Pré-preparo específico deste ingrediente nesta receita (picado, em cubos, desfiado...)"
    },
    "quantidade_por_porcao": {
      "type": "number",
      "description": "Quantidade líquida por porção. A unidade é definida em unidade_quantidade; legado assume g/ml conforme a receita."
    },
    "unidade_quantidade": {
      "type": "string",
      "enum": ["g", "ml"],
      "description": "Unidade canônica da quantidade deste item. Quando ausente, usa receita.unidade_base como compatibilidade."
    },
    "fator_correcao_override": {
      "type": "number",
      "description": "FC específico deste ingrediente nesta receita. Valor > 0 prevalece sobre Ingrediente.fator_correcao; 0/ausente significa usar o padrão do ingrediente."
    },
    "medida_caseira_id": {
      "type": "string",
      "description": "Referência canônica à MedidaCaseira escolhida para este item. Quando ausente, o app pode usar a medida padrão do ingrediente."
    },
    "quantidade_medida_caseira": {
      "type": "number",
      "description": "Quantidade de medidas informada pelo usuário. É metadado de entrada; g/ml permanecem como base de cálculo."
    },
    "medida_caseira": {
      "type": "string",
      "description": "LEGADO/CACHE de texto livre. Novas relações devem usar medida_caseira_id + quantidade_medida_caseira."
    },
    "ordem": {
      "type": "number",
      "description": "Ordem de exibição"
    },
    "tipo": {
      "type": "string",
      "enum": ["ingrediente", "grupo", "subreceita"],
      "default": "ingrediente",
      "description": "Discriminador canônico do item. Define quais referências e campos são válidos."
    },
    "titulo_grupo": {
      "type": "string",
      "description": "Título do grupo, usado somente quando tipo=grupo"
    },
    "subreceita_id": {
      "type": "string",
      "description": "Referência canônica à Receita usada como sub-receita quando tipo=subreceita. Na Fase 8 esta referência é a fonte de verdade da composição."
    },
    "subreceita_nome": {
      "type": "string",
      "description": "LEGADO/CACHE de exibição. Não usar como identidade; o nome canônico deve ser resolvido por subreceita_id."
    },
    "subreceita_parent_id": {
      "type": "string",
      "description": "ID do marcador de sub-receita pai. Quando preenchido, o registro é um filho derivado/cache e não uma fonte de composição independente."
    },
    "subreceita_modo": {
      "type": "string",
      "enum": ["referencia_cache", "snapshot_legado"],
      "description": "Modo da sub-receita. referencia_cache usa subreceita_id como fonte de verdade; snapshot_legado identifica estruturas históricas ainda não migradas."
    },
    "subreceita_sincronizacao_status": {
      "type": "string",
      "enum": ["sincronizada", "desatualizada", "a_validar", "pendente", "erro_ciclo", "origem_ausente"],
      "description": "Estado do cache derivado em relação à receita referenciada."
    },
    "subreceita_cache": {
      "type": "boolean",
      "default": false,
      "description": "True quando o item é ingrediente atômico derivado de uma sub-receita. Esses itens são cache operacional, não fonte de verdade."
    },
    "subreceita_cache_versao": {
      "type": "number",
      "description": "Versão do algoritmo que gerou o cache da sub-receita. Fase 8 usa versão 2."
    },
    "subreceita_origem_receita_id": {
      "type": "string",
      "description": "Receita de origem imediata do ingrediente atômico dentro da árvore de sub-receitas."
    },
    "subreceita_origem_item_id": {
      "type": "string",
      "description": "IngredienteReceita de origem imediata usado para gerar este cache."
    },
    "subreceita_linhagem": {
      "type": "string",
      "description": "Caminho de IDs de receitas, separado por >, usado para rastrear a linhagem do ingrediente derivado."
    },
    "subreceita_dependencias_assinatura": {
      "type": "string",
      "description": "Assinatura determinística receita@updated_date das dependências da árvore. Permite detectar alteração inclusive em sub-receitas aninhadas."
    },
    "subreceita_origem_updated_at": {
      "type": "string",
      "description": "Data de atualização da sub-receita raiz quando o cache foi gerado."
    },
    "subreceita_sincronizada_em": {
      "type": "string",
      "description": "Data/hora em que o cache derivado foi reconstruído com sucesso."
    },
    "proporcional": {
      "type": "boolean",
      "default": true,
      "description": "Indica se o item escala proporcionalmente com a receita (true) ou mantém quantidade fixa (false)."
    },
    "is_base": {
      "type": "boolean",
      "description": "Espelha se a receita-pai pertence ao catálogo-base compartilhado"
    },
    "usuario_dono_id": {
      "type": "string",
      "description": "ID do usuário dono quando a receita-pai é uma cópia pessoal"
    }
  },
  "required": ["receita_id"],
  "rls": {
    "create": {
      "$or": [
        {"user_condition": {"role": "admin"}},
        {"$and": [
          {"data.is_base": false},
          {"data.usuario_dono_id": "{{user.id}}"}
        ]}
      ]
    },
    "read": {
      "$or": [
        {"data.is_base": true},
        {"data.usuario_dono_id": "{{user.id}}"},
        {"user_condition": {"role": "admin"}}
      ]
    },
    "update": {
      "$or": [
        {"data.usuario_dono_id": "{{user.id}}"},
        {"user_condition": {"role": "admin"}}
      ]
    },
    "delete": {
      "$or": [
        {"data.usuario_dono_id": "{{user.id}}"},
        {"user_condition": {"role": "admin"}}
      ]
    }
  }
}
