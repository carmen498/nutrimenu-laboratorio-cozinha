{
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio dono da configura\u00e7\u00e3o; usado para consulta, enquanto a seguran\u00e7a usa created_by_id."
    },
    "metodo_rateio_padrao": {
      "type": "string",
      "enum": [
        "lote_produzido"
      ],
      "default": "lote_produzido",
      "description": "M\u00e9todo de rateio vigente: despesas mensais divididas pelo n\u00famero estimado de lotes/rendimentos completos produzidos no m\u00eas."
    },
    "volume_mensal_estimado": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "N\u00famero estimado de lotes/rendimentos completos produzidos no m\u00eas."
    },
    "unidade_volume": {
      "type": "string",
      "enum": [
        "lotes_mes"
      ],
      "default": "lotes_mes",
      "description": "Unidade da base mensal de rateio."
    },
    "grupos_rateio_incluidos": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "gastos_negocio",
          "trabalho_ajudantes",
          "producao",
          "embalagem_outros"
        ]
      },
      "default": [
        "gastos_negocio",
        "trabalho_ajudantes",
        "producao",
        "embalagem_outros"
      ],
      "description": "Grupos de despesas mensais inclu\u00eddos no Custo do Neg\u00f3cio. Lista vazia significa nenhum grupo inclu\u00eddo."
    },
    "aplicar_custo_negocio": {
      "type": "boolean",
      "default": false
    },
    "base_custo_negocio": {
      "type": "string",
      "enum": [
        "dia",
        "mes"
      ],
      "default": "mes"
    },
    "dias_producao_mes": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "producao_media_dia": {
      "type": "number",
      "minimum": 0,
      "default": 0
    },
    "custo_comercializacao_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 99,
      "default": 20
    },
    "aplicar_custo_comercializacao": {
      "type": "boolean",
      "default": false
    },
    "valor_hora_padrao": {
      "type": "number",
      "minimum": 0,
      "default": 0,
      "description": "Campo legado. N\u00e3o utilizado pelo fluxo atual."
    },
    "markup_padrao": {
      "type": "number",
      "minimum": 0,
      "default": 3,
      "description": "Markup padr\u00e3o sugerido para c\u00e1lculos assistidos."
    },
    "considera_impostos": {
      "type": "boolean",
      "default": false
    },
    "considera_taxa_cartao": {
      "type": "boolean",
      "default": false
    },
    "ativo": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  },
  "name": "ConfiguracaoCustosUsuario"
}