{
  "name": "Pagamento",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que realizou o pagamento"
    },
    "plano": {
      "type": "string",
      "enum": [
        "diario",
        "mensal",
        "anual",
        "renovacao",
        "custos_mensal",
        "custos_anual",
        "zr_tin",
        "zr_tin_renovacao",
        "zr_full",
        "zr_full_renovacao",
        "zr_arquitetura",
        "zr_arquitetura_renovacao",
        "zr_full_upgrade_tin",
        "zr_full_upgrade_arquitetura",
        "zr_full_upgrade_tin_arquitetura"
      ],
      "description": "Plano principal da tentativa. Para compra somente do Laborat\u00f3rio de Custos usa custos_mensal ou custos_anual; faixas do Guia T\u00e9cnico ZR usam prefixo zr_. Ofertas de upgrade (zr_full_upgrade_*) concedem a faixa full por pre\u00e7o menor."
    },
    "produto_compra": {
      "type": "string",
      "enum": [
        "laboratorio_cozinha",
        "laboratorio_custos",
        "cozinha_mais_custos",
        "guia_zr"
      ],
      "default": "laboratorio_cozinha",
      "description": "Escopo comercial do pagamento: produto-base, complemento isolado, compra combinada ou faixa do Guia T\u00e9cnico ZR."
    },
    "addon_plano_id": {
      "type": "string",
      "enum": [
        "custos_mensal",
        "custos_anual"
      ],
      "description": "Plano do Laborat\u00f3rio de Custos inclu\u00eddo na compra, quando houver."
    },
    "valor_cozinha": {
      "type": "number",
      "minimum": 0,
      "description": "Parcela do valor total atribu\u00edda ao Laborat\u00f3rio de Cozinha."
    },
    "valor_custos": {
      "type": "number",
      "minimum": 0,
      "description": "Parcela do valor total atribu\u00edda ao Laborat\u00f3rio de Custos."
    },
    "valor_guia_zr": {
      "type": "number",
      "minimum": 0,
      "description": "Parcela do valor total atribu\u00edda \u00e0 faixa do Guia T\u00e9cnico ZR."
    },
    "desconto_oferta_pct": {
      "type": "number",
      "minimum": 0,
      "description": "Desconto (%) da oferta de fim de trial aplicado server-side \u00e0 parcela do Laborat\u00f3rio de Cozinha, quando houver."
    },
    "desconto_pix_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Percentual de desconto PIX efetivamente aplicado pelo servidor a uma oferta do Guia T\u00e9cnico ZR."
    },
    "valor_sem_desconto": {
      "type": "number",
      "minimum": 0,
      "description": "Valor total antes do desconto da oferta, para auditoria comercial."
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "cartao",
        "pix"
      ],
      "description": "Forma de pagamento escolhida"
    },
    "valor": {
      "type": "number",
      "description": "Valor total cobrado em R$ (bruto), definido pelo servidor."
    },
    "valor_liquido": {
      "type": "number",
      "description": "Valor l\u00edquido em R$ recebido ap\u00f3s taxas/descontos. Quando n\u00e3o informado, considerar igual ao valor bruto"
    },
    "parcelas": {
      "type": "number",
      "default": 1,
      "description": "N\u00famero de parcelas (cart\u00e3o)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled",
        "estornado",
        "contestado",
        "estornado_parcial"
      ],
      "default": "pending",
      "description": "Status do pagamento. 'contestado' = chargeback; 'estornado_parcial' = estorno parcial (sem revoga\u00e7\u00e3o autom\u00e1tica)."
    },
    "mercadopago_order_id": {
      "type": "string",
      "description": "ID da order retornada pela Orders API do Mercado Pago"
    },
    "mercadopago_payment_id": {
      "type": "string",
      "description": "N\u00famero da transa\u00e7\u00e3o de pagamento dentro da order do Mercado Pago"
    },
    "pago_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora efetiva da aprova\u00e7\u00e3o informada pelo Mercado Pago, sempre em UTC com sufixo Z"
    },
    "estornado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da confirma\u00e7\u00e3o do estorno pelo Mercado Pago, sempre em UTC com sufixo Z"
    },
    "valor_estornado": {
      "type": "number",
      "minimum": 0,
      "description": "Valor efetivamente devolvido segundo o Mercado Pago"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Chave de idempot\u00eancia derivada no servidor para identificar uma tentativa de checkout"
    },
    "termos_aceitos_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora server-side do aceite expl\u00edcito dos documentos legais"
    },
    "termos_versao_aceita": {
      "type": "string",
      "description": "Vers\u00e3o dos Termos de Uso aceita"
    },
    "privacidade_versao_aceita": {
      "type": "string",
      "description": "Vers\u00e3o da Pol\u00edtica de Privacidade aceita"
    },
    "qr_code": {
      "type": "string",
      "description": "C\u00f3digo copia-e-cola do PIX"
    },
    "qr_code_base64": {
      "type": "string",
      "description": "QR code em base64 do PIX"
    },
    "detalhe_erro": {
      "type": "string",
      "description": "Resumo t\u00e9cnico sanitizado da falha."
    },
    "dados_transitorios_limpos_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que dados transit\u00f3rios foram removidos"
    },
    "versao_codigo": {
      "type": "string",
      "description": "Identificador da vers\u00e3o do c\u00f3digo da function que processou esta tentativa"
    },
    "nota_fiscal_url": {
      "type": "string",
      "description": "URL da nota fiscal emitida para este pagamento, quando existir"
    },
    "lembrete_pendencia_enviado": {
      "type": "boolean",
      "default": false,
      "description": "true quando o lembrete de pagamento pendente j\u00e1 foi disparado"
    },
    "prazo_desistencia_em": {
      "type": "string",
      "format": "date-time",
      "description": "Prazo final do direito de arrependimento, decidido e gravado pelo servidor no momento da compra, sempre em UTC com sufixo Z."
    },
    "desistencia_solicitada_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora do pedido de desist\u00eancia (direito de arrependimento de 7 dias) associado a este pagamento.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    }
  },
  "required": [
    "plano",
    "forma_pagamento",
    "valor",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.usuario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}