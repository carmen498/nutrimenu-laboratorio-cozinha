{
  "name": "Pagamento",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que realizou o pagamento"
    },
    "plano": {
      "type": "string",
      "enum": [
        "diario",
        "mensal",
        "anual",
        "renovacao",
        "custos_mensal",
        "custos_anual"
      ],
      "description": "Plano principal da tentativa. Para compra somente do Laborat\u00f3rio de Custos usa custos_mensal ou custos_anual."
    },
    "produto_compra": {
      "type": "string",
      "enum": [
        "laboratorio_cozinha",
        "laboratorio_custos",
        "cozinha_mais_custos"
      ],
      "default": "laboratorio_cozinha",
      "description": "Escopo comercial do pagamento: produto-base, complemento isolado ou compra combinada."
    },
    "addon_plano_id": {
      "type": "string",
      "enum": [
        "custos_mensal",
        "custos_anual"
      ],
      "description": "Plano do Laborat\u00f3rio de Custos inclu\u00eddo na compra, quando houver."
    },
    "valor_cozinha": {
      "type": "number",
      "minimum": 0,
      "description": "Parcela do valor total atribu\u00edda ao Laborat\u00f3rio de Cozinha."
    },
    "valor_custos": {
      "type": "number",
      "minimum": 0,
      "description": "Parcela do valor total atribu\u00edda ao Laborat\u00f3rio de Custos."
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "cartao",
        "pix"
      ],
      "description": "Forma de pagamento escolhida"
    },
    "valor": {
      "type": "number",
      "description": "Valor total cobrado em R$ (bruto), definido pelo servidor."
    },
    "valor_liquido": {
      "type": "number",
      "description": "Valor l\u00edquido em R$ recebido ap\u00f3s taxas/descontos. Quando n\u00e3o informado, considerar igual ao valor bruto"
    },
    "parcelas": {
      "type": "number",
      "default": 1,
      "description": "N\u00famero de parcelas (cart\u00e3o)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled",
        "estornado"
      ],
      "default": "pending",
      "description": "Status do pagamento."
    },
    "mercadopago_order_id": {
      "type": "string",
      "description": "ID da order retornada pela Orders API do Mercado Pago"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Chave de idempot\u00eancia derivada no servidor para identificar uma tentativa de checkout"
    },
    "termos_aceitos_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora server-side do aceite expl\u00edcito dos documentos legais"
    },
    "termos_versao_aceita": {
      "type": "string",
      "description": "Vers\u00e3o dos Termos de Uso aceita"
    },
    "privacidade_versao_aceita": {
      "type": "string",
      "description": "Vers\u00e3o da Pol\u00edtica de Privacidade aceita"
    },
    "qr_code": {
      "type": "string",
      "description": "C\u00f3digo copia-e-cola do PIX"
    },
    "qr_code_base64": {
      "type": "string",
      "description": "QR code em base64 do PIX"
    },
    "detalhe_erro": {
      "type": "string",
      "description": "Resumo t\u00e9cnico sanitizado da falha."
    },
    "dados_transitorios_limpos_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que dados transit\u00f3rios foram removidos"
    },
    "versao_codigo": {
      "type": "string",
      "description": "Identificador da vers\u00e3o do c\u00f3digo da function que processou esta tentativa"
    },
    "nota_fiscal_url": {
      "type": "string",
      "description": "URL da nota fiscal emitida para este pagamento, quando existir"
    },
    "lembrete_pendencia_enviado": {
      "type": "boolean",
      "default": false,
      "description": "true quando o lembrete de pagamento pendente j\u00e1 foi disparado"
    }
  },
  "required": [
    "plano",
    "forma_pagamento",
    "valor",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.usuario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}