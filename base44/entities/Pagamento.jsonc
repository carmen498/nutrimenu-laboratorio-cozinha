{
  "name": "Pagamento",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio que realizou o pagamento"
    },
    "plano": {
      "type": "string",
      "enum": [
        "diario",
        "mensal",
        "anual"
      ],
      "description": "Plano contratado nesta tentativa de pagamento"
    },
    "forma_pagamento": {
      "type": "string",
      "enum": [
        "cartao",
        "pix"
      ],
      "description": "Forma de pagamento escolhida"
    },
    "valor": {
      "type": "number",
      "description": "Valor cobrado em R$, definido pelo servidor a partir do AppConfig"
    },
    "parcelas": {
      "type": "number",
      "default": 1,
      "description": "N\u00famero de parcelas (cart\u00e3o)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "cancelled"
      ],
      "default": "pending",
      "description": "Status do pagamento"
    },
    "mercadopago_order_id": {
      "type": "string",
      "description": "ID da order retornada pela Orders API do Mercado Pago"
    },
    "idempotency_key": {
      "type": "string",
      "description": "Chave de idempot\u00eancia gerada pelo servidor no in\u00edcio da tentativa"
    },
    "qr_code": {
      "type": "string",
      "description": "C\u00f3digo copia-e-cola do PIX (quando forma_pagamento=pix)"
    },
    "qr_code_base64": {
      "type": "string",
      "description": "QR code em base64 do PIX (quando forma_pagamento=pix)"
    },
    "detalhe_erro": {
      "type": "string",
      "description": "Detalhe de erro retornado pelo Mercado Pago, se a tentativa falhar"
    },
    "versao_codigo": {
      "type": "string",
      "description": "Identificador da vers\u00e3o do c\u00f3digo da function que processou esta tentativa (para confirmar se o deploy mais recente est\u00e1 ativo)"
    }
  },
  "required": [
    "plano",
    "forma_pagamento",
    "valor",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.usuario_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}