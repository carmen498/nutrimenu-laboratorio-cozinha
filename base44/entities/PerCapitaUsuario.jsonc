{
  "name": "PerCapitaUsuario",
  "type": "object",
  "properties": {
    "prep_nome": {
      "type": "string",
      "description": "Nome da preparação (chave da tabela original ou item novo)"
    },
    "per_capita_g": {
      "type": "number",
      "description": "Valor de per capita personalizado pelo usuário"
    },
    "original_g": {
      "type": "number",
      "description": "Valor original da tabela (0 para itens criados pelo usuário)"
    },
    "medida": {
      "type": "string",
      "description": "Medida caseira (para itens criados pelo usuário)"
    },
    "grupo": {
      "type": "string",
      "description": "Grupo da preparação (para itens criados pelo usuário)"
    }
  },
  "required": ["prep_nome", "per_capita_g", "original_g"],
  "rls": {
    "create": {
      "$or": [
        { "user_condition": { "role": "user" } },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "read": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}