{
  "name": "Planejamento",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do planejamento"
    },
    "tipo_planejamento": {
      "type": "string",
      "enum": [
        "Almoço",
        "Jantar",
        "Coquetel",
        "Data Comemorativa",
        "Confraternização",
        "Outro"
      ],
      "description": "Tipo do planejamento"
    },
    "tipo_servico": {
      "type": "string",
      "enum": [
        "Bufê",
        "Empratado",
        "À La Carte",
        "Refeição Familiar",
        "Self-Service",
        "Outro"
      ],
      "description": "Tipo de serviço"
    },
    "horario_inicio": {
      "type": "string",
      "description": "Horário de início (HH:MM)"
    },
    "duracao_horas": {
      "type": "number",
      "description": "Duração estimada em horas"
    },
    "qtd_homens": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de homens"
    },
    "qtd_mulheres": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de mulheres"
    },
    "qtd_criancas": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de crianças"
    },
    "per_capita_homens_g": {
      "type": "number",
      "default": 600,
      "description": "Per capita homens em gramas"
    },
    "per_capita_mulheres_g": {
      "type": "number",
      "default": 400,
      "description": "Per capita mulheres em gramas"
    },
    "per_capita_criancas_g": {
      "type": "number",
      "default": 300,
      "description": "Per capita crianças em gramas"
    },
    "margem_seguranca_pct": {
      "type": "number",
      "default": 20,
      "description": "Margem de segurança em percentual"
    },
    "total_base_kg": {
      "type": "number",
      "description": "Total base em kg (sem margem)"
    },
    "total_com_margem_kg": {
      "type": "number",
      "description": "Total com margem em kg"
    },
    "total_pessoas": {
      "type": "number",
      "description": "Total de pessoas"
    },
    "cardapio_config": {
      "type": "string",
      "description": "Configuração do cardápio (JSON: grupos, itens e receitas)"
    },
    "margem_seguranca_evento_pct": {
      "type": "number",
      "default": 0,
      "description": "Margem de segurança única do cardápio do evento (Etapa 3), em percentual. Cálculo: kg do prato = pessoas × PC × (1 + margem%)"
    },
    "observacoes_orcamento": {
      "type": "string",
      "description": "Observações comerciais do Orçamento do evento (documento do cliente) — distintas das observações de produção"
    },
    "preco_pessoa_orcamento": {
      "type": "number",
      "description": "Preço por pessoa digitado na geração do Orçamento do evento (usado quando não há mecanismo de markup ativo)"
    }
  },
  "required": [
    "nome",
    "tipo_planejamento",
    "tipo_servico"
  ],
  "rls": {
    "create": {
      "$or": [
        { "user_condition": { "role": "user" } },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "read": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "update": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    },
    "delete": {
      "$or": [
        { "created_by_id": "{{user.id}}" },
        { "user_condition": { "role": "admin" } }
      ]
    }
  }
}