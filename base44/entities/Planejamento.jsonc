{
  "name": "Planejamento",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do planejamento"
    },
    "tipo_planejamento": {
      "type": "string",
      "enum": [
        "Almo\u00e7o",
        "Jantar",
        "Coquetel",
        "Data Comemorativa",
        "Confraterniza\u00e7\u00e3o",
        "Outro"
      ],
      "description": "Tipo do planejamento"
    },
    "tipo_servico": {
      "type": "string",
      "enum": [
        "Buf\u00ea",
        "Empratado",
        "\u00c0 La Carte",
        "Refei\u00e7\u00e3o Familiar",
        "Self-Service",
        "Outro"
      ],
      "description": "Tipo de servi\u00e7o"
    },
    "horario_inicio": {
      "type": "string",
      "description": "Hor\u00e1rio de in\u00edcio (HH:MM)"
    },
    "duracao_horas": {
      "type": "number",
      "description": "Dura\u00e7\u00e3o estimada em horas"
    },
    "qtd_homens": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de homens"
    },
    "qtd_mulheres": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de mulheres"
    },
    "qtd_criancas": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de crian\u00e7as"
    },
    "per_capita_homens_g": {
      "type": "number",
      "default": 600,
      "description": "Per capita homens em gramas"
    },
    "per_capita_mulheres_g": {
      "type": "number",
      "default": 400,
      "description": "Per capita mulheres em gramas"
    },
    "per_capita_criancas_g": {
      "type": "number",
      "default": 300,
      "description": "Per capita crian\u00e7as em gramas"
    },
    "margem_seguranca_pct": {
      "type": "number",
      "default": 20,
      "description": "Margem de seguran\u00e7a em percentual"
    },
    "total_base_kg": {
      "type": "number",
      "description": "Total base em kg (sem margem)"
    },
    "total_com_margem_kg": {
      "type": "number",
      "description": "Total com margem em kg"
    },
    "total_pessoas": {
      "type": "number",
      "description": "Total de pessoas"
    },
    "cardapio_config": {
      "type": "string",
      "description": "Configura\u00e7\u00e3o do card\u00e1pio (JSON: grupos, itens e receitas)"
    },
    "margem_seguranca_evento_pct": {
      "type": "number",
      "default": 0,
      "description": "Margem de seguran\u00e7a \u00fanica do card\u00e1pio do evento (Etapa 3), em percentual. C\u00e1lculo: kg do prato = pessoas \u00d7 PC \u00d7 (1 + margem%)"
    },
    "observacoes_orcamento": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es comerciais do Or\u00e7amento do evento (documento do cliente) \u2014 distintas das observa\u00e7\u00f5es de produ\u00e7\u00e3o"
    },
    "preco_pessoa_orcamento": {
      "type": "number",
      "description": "LEGADO: pre\u00e7o por pessoa usado em or\u00e7amentos anteriores"
    },
    "preco_final_orcamento": {
      "type": "number",
      "minimum": 0,
      "description": "Pre\u00e7o final total cobrado do cliente, persistido no or\u00e7amento do evento"
    }
  },
  "required": [
    "nome",
    "tipo_planejamento",
    "tipo_servico"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "user"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}