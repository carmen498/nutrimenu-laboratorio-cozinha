{
  "name": "SinonimosIngredientes",
  "type": "object",
  "properties": {
    "ingrediente_id": {
      "type": "string",
      "description": "ID do ingrediente vinculado"
    },
    "sinonimo": {
      "type": "string",
      "description": "Texto do sinônimo (único na tabela, case-insensitive)"
    }
  },
  "required": ["ingrediente_id", "sinonimo"],
  "rls": {
    "read": {},
    "create": { "user_condition": { "role": "admin" } },
    "update": { "user_condition": { "role": "admin" } },
    "delete": { "user_condition": { "role": "admin" } }
  }
}