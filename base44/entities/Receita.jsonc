{
  "name": "Receita",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da receita"
    },
    "categorias": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Carnes Bovinas e Suínos",
          "Aves",
          "Peixes e Frutos do Mar",
          "Ovos",
          "Massas, Pastelão e Quiches",
          "Arroz e Risotos",
          "Sopas e Caldos",
          "Leguminosas",
          "Salgadinhos",
          "Pães e Bolos",
          "Sobremesas",
          "Molhos",
          "Acompanhamentos",
          "Pratos Principais",
          "Entradas",
          "Lanche",
          "Receitas Base"
        ]
      },
      "default": [],
      "description": "Categorias da receita (múltiplas)"
    },
    "porcoes_base": {
      "type": "number",
      "description": "Número de porções base"
    },
    "rendimento_total": {
      "type": "number",
      "description": "LEGADO/CACHE compatível do peso pós-preparo (PDP). Novas gravações devem manter sincronizado com peso_pos_preparo_total."
    },
    "peso_pre_preparo_total": {
      "type": "number",
      "description": "Snapshot do peso/volume líquido total imediatamente antes do preparo/cocção. Não inclui FC de compra."
    },
    "peso_pos_preparo_total": {
      "type": "number",
      "description": "Peso/volume total depois de pronto (PDP), usado como rendimento técnico canônico."
    },
    "rendimento_origem": {
      "type": "string",
      "enum": ["medido", "estimado", "legado", "importado"],
      "description": "Origem do valor de rendimento/PDP."
    },
    "rendimento_status": {
      "type": "string",
      "enum": ["confirmado", "estimado", "a_validar", "pendente"],
      "description": "Estado técnico do rendimento. Confirmado = PDP medido; a_validar = existe valor sem validação técnica; pendente = sem PDP medido."
    },
    "rendimento_medido_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da última medição confirmada do peso pós-preparo."
    },
    "unidade_base": {
      "type": "string",
      "enum": ["g", "ml"],
      "description": "Unidade base da receita: g (sólidos) ou ml (líquidos)"
    },
    "modo_preparo": {
      "type": "string",
      "description": "Modo de preparo"
    },
    "descritivo_menu": {
      "type": "string",
      "description": "Descritivo da receita voltado ao cliente final (para menu/cardápio)"
    },
    "mostrar_fc": {
      "type": "boolean",
      "default": false,
      "description": "Exibir colunas FC e Peso Bruto na tabela de ingredientes da ficha"
    },
    "mostrar_medida_caseira": {
      "type": "boolean",
      "default": false,
      "description": "Exibir coluna Medida Caseira na tabela de ingredientes da ficha"
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto da receita"
    },
    "custo_total": {
      "type": "number",
      "description": "Custo total calculado"
    },
    "custo_insumos": {
      "type": "number",
      "description": "Custo total de insumos e embalagens"
    },
    "custo_por_porcao": {
      "type": "number",
      "description": "Custo por porção calculado"
    },
    "revisar": {
      "type": "boolean",
      "description": "Flag: Duplicado — revisar"
    },
    "favorita": {
      "type": "boolean",
      "default": false,
      "description": "Flag: Receita favorita"
    },
    "per_capita_g": {
      "type": "number",
      "description": "Per capita recomendado em gramas (override do usuário)"
    },
    "nota": {
      "type": "string",
      "description": "Nota/observações livres da receita (ex: ajustes, ingredientes pendentes de importação)"
    },
    "cor_predominante": {
      "type": "string",
      "description": "Cor predominante do prato para análise visual do cardápio. Formato: `familia__tom` (ex: verde__escuro). Vazio = sem cor."
    },
    "destaque": {
      "type": "boolean",
      "default": false,
      "description": "Receita marcada manualmente para aparecer na vitrine 'Receitas em Destaque' da Home"
    },
    "is_base": {
      "type": "boolean",
      "default": true,
      "description": "Escopo canônico: true = catálogo compartilhado; false = receita pessoal. Usuários comuns nunca devem criar is_base=true."
    },
    "usuario_dono_id": {
      "type": "string",
      "description": "Propriedade canônica da receita pessoal. Vazio em receitas do catálogo; em receitas pessoais deve apontar para o usuário dono."
    },
    "receita_origem_id": {
      "type": "string",
      "description": "Origem imediata canônica da receita derivada. Vazio quando a receita é raiz."
    },
    "receita_raiz_id": {
      "type": "string",
      "description": "ID do ancestral raiz da linhagem. Em receitas raiz aponta para o próprio ID; em derivações permanece estável através das gerações."
    },
    "linhagem_geracao": {
      "type": "number",
      "description": "Distância até a receita raiz: 0 para raiz, 1 para derivação direta e assim por diante."
    },
    "linhagem_tipo": {
      "type": "string",
      "enum": ["catalogo", "autoral", "personalizacao", "duplicacao", "importacao"],
      "description": "Natureza da receita na linhagem. catalogo/autoral são raízes; personalizacao/duplicacao/importacao descrevem derivações quando aplicável."
    },
    "linhagem_versao": {
      "type": "number",
      "description": "Versão do modelo de propriedade/linhagem. A Fase 9 usa versão 1."
    },
    "linhagem_status": {
      "type": "string",
      "enum": ["canonica", "a_validar", "origem_ausente", "ciclo"],
      "description": "Estado da linhagem persistida. Registros históricos inconsistentes são preservados e marcados para revisão."
    },
    "forked_from_id": {
      "type": "string",
      "description": "LEGADO/COMPATIBILIDADE do fork-on-edit. Na Fase 9 a origem canônica é receita_origem_id; para personalizações novas este campo é mantido sincronizado temporariamente."
    },
    "data_personalizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de criação de uma receita pessoal/personalização."
    }
  },
  "required": ["nome"],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.is_base": false
            },
            {
              "data.usuario_dono_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.is_base": true
        },
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
