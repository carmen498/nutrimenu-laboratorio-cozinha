{
  "name": "Receita",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da receita"
    },
    "categorias": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Carnes Bovinas e Su\u00ednos",
          "Aves",
          "Peixes e Frutos do Mar",
          "Ovos",
          "Massas, Pastel\u00e3o e Quiches",
          "Arroz e Risotos",
          "Sopas e Caldos",
          "Leguminosas",
          "Salgadinhos",
          "P\u00e3es e Bolos",
          "Sobremesas",
          "Molhos",
          "Acompanhamentos",
          "Pratos Principais",
          "Entradas",
          "Lanche",
          "Receitas Base"
        ]
      },
      "default": [],
      "description": "Categorias da receita (m\u00faltiplas)"
    },
    "porcoes_base": {
      "type": "number",
      "description": "N\u00famero de por\u00e7\u00f5es base"
    },
    "rendimento_total": {
      "type": "number",
      "description": "LEGADO/CACHE compat\u00edvel do peso p\u00f3s-preparo (PDP). Novas grava\u00e7\u00f5es devem manter sincronizado com peso_pos_preparo_total."
    },
    "peso_pre_preparo_total": {
      "type": "number",
      "description": "Snapshot do peso/volume l\u00edquido total imediatamente antes do preparo/coc\u00e7\u00e3o. N\u00e3o inclui FC de compra."
    },
    "peso_pos_preparo_total": {
      "type": "number",
      "description": "Peso/volume total depois de pronto (PDP), usado como rendimento t\u00e9cnico can\u00f4nico."
    },
    "rendimento_origem": {
      "type": "string",
      "enum": [
        "medido",
        "estimado",
        "legado",
        "importado"
      ],
      "description": "Origem do valor de rendimento/PDP."
    },
    "rendimento_status": {
      "type": "string",
      "enum": [
        "confirmado",
        "estimado",
        "a_validar",
        "pendente"
      ],
      "description": "Estado t\u00e9cnico do rendimento. Confirmado = PDP medido; a_validar = existe valor sem valida\u00e7\u00e3o t\u00e9cnica; pendente = sem PDP medido."
    },
    "rendimento_medido_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da \u00faltima medi\u00e7\u00e3o confirmada do peso p\u00f3s-preparo."
    },
    "unidade_base": {
      "type": "string",
      "enum": [
        "g",
        "ml"
      ],
      "description": "Unidade base da receita: g (s\u00f3lidos) ou ml (l\u00edquidos)"
    },
    "modo_preparo": {
      "type": "string",
      "description": "Modo de preparo"
    },
    "descritivo_menu": {
      "type": "string",
      "description": "Descritivo da receita voltado ao cliente final (para menu/card\u00e1pio)"
    },
    "mostrar_fc": {
      "type": "boolean",
      "default": false,
      "description": "Exibir colunas FC e Peso Bruto na tabela de ingredientes da ficha"
    },
    "mostrar_medida_caseira": {
      "type": "boolean",
      "default": false,
      "description": "Exibir coluna Medida Caseira na tabela de ingredientes da ficha"
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto da receita"
    },
    "custo_total": {
      "type": "number",
      "description": "CACHE PERSISTIDO de custo da receita. Em receitas compartilhadas representa refer\u00eancia global com pre\u00e7os mestre; nunca deve ser usado como fonte de verdade para pre\u00e7o pessoal do usu\u00e1rio."
    },
    "custo_insumos": {
      "type": "number",
      "description": "CACHE PERSISTIDO do custo de insumos/embalagens do lote. A fonte de verdade permanece nos registros InsumoReceita."
    },
    "custo_por_porcao": {
      "type": "number",
      "description": "CACHE PERSISTIDO do custo por por\u00e7\u00e3o. Consumidores com contexto comercial devem recalcular pelo Motor de Custos Can\u00f4nico."
    },
    "custo_modelo_versao": {
      "type": "number",
      "description": "Vers\u00e3o do modelo usado para gerar o cache de custos. A Fase 10 usa vers\u00e3o 2."
    },
    "custo_cache_status": {
      "type": "string",
      "enum": [
        "atual",
        "a_recalcular",
        "incompleto",
        "legado"
      ],
      "description": "Estado do cache persistido. incompleto indica refer\u00eancia/pre\u00e7o ausente; o c\u00e1lculo ao vivo continua sendo a fonte de verdade."
    },
    "custo_cache_atualizado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da \u00faltima normaliza\u00e7\u00e3o do cache de custos."
    },
    "custo_cache_contexto": {
      "type": "string",
      "enum": [
        "global",
        "proprietario"
      ],
      "description": "Contexto do cache persistido: global para cat\u00e1logo compartilhado; proprietario para receita pessoal."
    },
    "custo_cache_itens_sem_preco": {
      "type": "number",
      "description": "Quantidade de itens que impedem o cache de ser considerado completo."
    },
    "custo_cache_invalido": {
      "type": "boolean",
      "default": false,
      "description": "Fase 10.3: indica que alguma depend\u00eancia de custo mudou desde a \u00faltima normaliza\u00e7\u00e3o do cache."
    },
    "custo_cache_invalidado_em": {
      "type": "string",
      "format": "date-time",
      "description": "Fase 10.3: data/hora da \u00faltima invalida\u00e7\u00e3o autom\u00e1tica do cache."
    },
    "custo_cache_invalidacao_motivo": {
      "type": "string",
      "description": "Fase 10.3: motivo t\u00e9cnico da \u00faltima invalida\u00e7\u00e3o autom\u00e1tica."
    },
    "custo_cache_invalidacao_origem": {
      "type": "string",
      "description": "Fase 10.3: fluxo que originou a invalida\u00e7\u00e3o (receita, ingrediente, sub-receita, insumo etc.)."
    },
    "custo_cache_invalidacao_profundidade": {
      "type": "number",
      "description": "Fase 10.3: dist\u00e2ncia da altera\u00e7\u00e3o raiz na cadeia reversa de sub-receitas; 0 = receita diretamente afetada."
    },
    "custo_cache_assinatura": {
      "type": "string",
      "description": "Fase 10.4: assinatura sem\u00e2ntica dos determinantes de custo usados na \u00faltima normaliza\u00e7\u00e3o do cache."
    },
    "custo_cache_assinatura_versao": {
      "type": "number",
      "description": "Vers\u00e3o do algoritmo da assinatura can\u00f4nica de custos."
    },
    "custo_cache_assinatura_status": {
      "type": "string",
      "enum": [
        "valida",
        "divergente",
        "ausente"
      ],
      "description": "Fase 10.4: compara a assinatura persistida com os determinantes atuais do custo."
    },
    "custo_cache_assinatura_gerada_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora em que a assinatura persistida foi gerada."
    },
    "revisar": {
      "type": "boolean",
      "description": "Flag: Duplicado \u2014 revisar"
    },
    "favorita": {
      "type": "boolean",
      "default": false,
      "description": "Flag: Receita favorita"
    },
    "per_capita_g": {
      "type": "number",
      "description": "Per capita recomendado em gramas (override do usu\u00e1rio)"
    },
    "nota": {
      "type": "string",
      "description": "Nota/observa\u00e7\u00f5es livres da receita (ex: ajustes, ingredientes pendentes de importa\u00e7\u00e3o)"
    },
    "cor_predominante": {
      "type": "string",
      "description": "Cor predominante do prato para an\u00e1lise visual do card\u00e1pio. Formato: `familia__tom` (ex: verde__escuro). Vazio = sem cor."
    },
    "destaque": {
      "type": "boolean",
      "default": false,
      "description": "Receita marcada manualmente para aparecer na vitrine 'Receitas em Destaque' da Home"
    },
    "is_base": {
      "type": "boolean",
      "default": false,
      "description": "Escopo can\u00f4nico: true = cat\u00e1logo compartilhado; false = receita pessoal. Usu\u00e1rios comuns nunca devem criar is_base=true.",
      "rls": {
        "write": {
          "user_condition": {
            "role": "admin"
          }
        }
      }
    },
    "usuario_dono_id": {
      "type": "string",
      "description": "Propriedade can\u00f4nica da receita pessoal. Vazio em receitas do cat\u00e1logo; em receitas pessoais deve apontar para o usu\u00e1rio dono."
    },
    "receita_origem_id": {
      "type": "string",
      "description": "Origem imediata can\u00f4nica da receita derivada. Vazio quando a receita \u00e9 raiz."
    },
    "receita_raiz_id": {
      "type": "string",
      "description": "ID do ancestral raiz da linhagem. Em receitas raiz aponta para o pr\u00f3prio ID; em deriva\u00e7\u00f5es permanece est\u00e1vel atrav\u00e9s das gera\u00e7\u00f5es."
    },
    "linhagem_geracao": {
      "type": "number",
      "description": "Dist\u00e2ncia at\u00e9 a receita raiz: 0 para raiz, 1 para deriva\u00e7\u00e3o direta e assim por diante."
    },
    "linhagem_tipo": {
      "type": "string",
      "enum": [
        "catalogo",
        "autoral",
        "personalizacao",
        "duplicacao",
        "importacao"
      ],
      "description": "Natureza da receita na linhagem. catalogo/autoral s\u00e3o ra\u00edzes; personalizacao/duplicacao/importacao descrevem deriva\u00e7\u00f5es quando aplic\u00e1vel."
    },
    "linhagem_versao": {
      "type": "number",
      "description": "Vers\u00e3o do modelo de propriedade/linhagem. A Fase 9 usa vers\u00e3o 1."
    },
    "linhagem_status": {
      "type": "string",
      "enum": [
        "canonica",
        "a_validar",
        "origem_ausente",
        "ciclo"
      ],
      "description": "Estado da linhagem persistida. Registros hist\u00f3ricos inconsistentes s\u00e3o preservados e marcados para revis\u00e3o."
    },
    "forked_from_id": {
      "type": "string",
      "description": "LEGADO/COMPATIBILIDADE do fork-on-edit. Na Fase 9 a origem can\u00f4nica \u00e9 receita_origem_id; para personaliza\u00e7\u00f5es novas este campo \u00e9 mantido sincronizado temporariamente."
    },
    "data_personalizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora de cria\u00e7\u00e3o de uma receita pessoal/personaliza\u00e7\u00e3o."
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.usuario_dono_id": "{{user.id}}"
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.is_base": true
        },
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.usuario_dono_id": "{{user.id}}"
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}