{
  "name": "Receita",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da receita"
    },
    "categorias": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Carnes",
          "Aves",
          "Peixes e Frutos do Mar",
          "Ovos",
          "Massas, Pastel\u00e3o e Quiches",
          "Arroz e Risotos",
          "Sopas e Caldos",
          "Leguminosas",
          "Salgadinhos",
          "P\u00e3es e Bolos",
          "Sobremesas",
          "Molhos",
          "Acompanhamentos",
          "Pratos Principais",
          "Entradas",
          "Lanche",
          "Receitas Base"
        ]
      },
      "default": [],
      "description": "Categorias da receita (m\u00faltiplas)"
    },
    "porcoes_base": {
      "type": "number",
      "description": "N\u00famero de por\u00e7\u00f5es base"
    },
    "rendimento_total": {
      "type": "number",
      "description": "Rendimento total em g ou ml"
    },
    "unidade_base": {
      "type": "string",
      "enum": [
        "g",
        "ml"
      ],
      "description": "Unidade base da receita: g (s\u00f3lidos) ou ml (l\u00edquidos)"
    },
    "modo_preparo": {
      "type": "string",
      "description": "Modo de preparo"
    },
    "descritivo_menu": {
      "type": "string",
      "description": "Descritivo da receita voltado ao cliente final (para menu/card\u00e1pio)"
    },
    "mostrar_fc": {
      "type": "boolean",
      "default": false,
      "description": "Exibir colunas FC e Peso Bruto na tabela de ingredientes da ficha"
    },
    "mostrar_medida_caseira": {
      "type": "boolean",
      "default": false,
      "description": "Exibir coluna Medida Caseira na tabela de ingredientes da ficha"
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto da receita"
    },
    "custo_total": {
      "type": "number",
      "description": "Custo total calculado"
    },
    "custo_insumos": {
      "type": "number",
      "description": "Custo total de insumos e embalagens"
    },
    "custo_por_porcao": {
      "type": "number",
      "description": "Custo por por\u00e7\u00e3o calculado"
    },
    "revisar": {
      "type": "boolean",
      "description": "Flag: Duplicado \u2014 revisar"
    },
    "favorita": {
      "type": "boolean",
      "default": false,
      "description": "Flag: Receita favorita"
    },
    "per_capita_g": {
      "type": "number",
      "description": "Per capita recomendado em gramas (override do usu\u00e1rio)"
    },
    "nota": {
      "type": "string",
      "description": "Nota/observa\u00e7\u00f5es livres da receita (ex: ajustes, ingredientes pendentes de importa\u00e7\u00e3o)"
    },
    "cor_predominante": {
      "type": "string",
      "description": "Cor predominante do prato para an\u00e1lise visual do card\u00e1pio. Formato: `familia__tom` (ex: verde__escuro). Vazio = sem cor."
    }
  },
  "required": [
    "nome"
  ]
}