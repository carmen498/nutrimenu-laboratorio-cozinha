{
  "name": "Receita",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da receita"
    },
    "categorias": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Carnes",
          "Aves",
          "Peixes e Frutos do Mar",
          "Ovos",
          "Massas, Pastel\u00e3o e Quiches",
          "Arroz e Risotos",
          "Sopas e Caldos",
          "Leguminosas",
          "Salgadinhos",
          "P\u00e3es e Bolos",
          "Sobremesas",
          "Molhos",
          "Acompanhamentos",
          "Pratos Principais",
          "Entradas",
          "Lanche",
          "Receitas Base"
        ]
      },
      "default": [],
      "description": "Categorias da receita (m\u00faltiplas)"
    },
    "porcoes_base": {
      "type": "number",
      "description": "N\u00famero de por\u00e7\u00f5es base"
    },
    "rendimento_total": {
      "type": "number",
      "description": "Rendimento total em g ou ml"
    },
    "unidade_base": {
      "type": "string",
      "enum": [
        "g",
        "ml"
      ],
      "description": "Unidade base da receita: g (s\u00f3lidos) ou ml (l\u00edquidos)"
    },
    "modo_preparo": {
      "type": "string",
      "description": "Modo de preparo"
    },
    "descritivo_menu": {
      "type": "string",
      "description": "Descritivo da receita voltado ao cliente final (para menu/card\u00e1pio)"
    },
    "mostrar_fc": {
      "type": "boolean",
      "default": false,
      "description": "Exibir colunas FC e Peso Bruto na tabela de ingredientes da ficha"
    },
    "mostrar_medida_caseira": {
      "type": "boolean",
      "default": false,
      "description": "Exibir coluna Medida Caseira na tabela de ingredientes da ficha"
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto da receita"
    },
    "custo_total": {
      "type": "number",
      "description": "Custo total calculado"
    },
    "custo_insumos": {
      "type": "number",
      "description": "Custo total de insumos e embalagens"
    },
    "custo_por_porcao": {
      "type": "number",
      "description": "Custo por por\u00e7\u00e3o calculado"
    },
    "revisar": {
      "type": "boolean",
      "description": "Flag: Duplicado \u2014 revisar"
    },
    "favorita": {
      "type": "boolean",
      "default": false,
      "description": "Flag: Receita favorita"
    },
    "per_capita_g": {
      "type": "number",
      "description": "Per capita recomendado em gramas (override do usu\u00e1rio)"
    },
    "nota": {
      "type": "string",
      "description": "Nota/observa\u00e7\u00f5es livres da receita (ex: ajustes, ingredientes pendentes de importa\u00e7\u00e3o)"
    },
    "cor_predominante": {
      "type": "string",
      "description": "Cor predominante do prato para an\u00e1lise visual do card\u00e1pio. Formato: `familia__tom` (ex: verde__escuro). Vazio = sem cor."
    },
    "destaque": {
      "type": "boolean",
      "default": false,
      "description": "Receita marcada manualmente para aparecer na vitrine 'Receitas em Destaque' da Home"
    },
    "is_base": {
      "type": "boolean",
      "default": true,
      "description": "true = receita do cat\u00e1logo compartilhado original; false = c\u00f3pia pessoal criada automaticamente ao editar (fork-on-edit)"
    },
    "forked_from_id": {
      "type": "string",
      "description": "Quando is_base=false, ID da receita original (is_base=true) da qual esta \u00e9 uma c\u00f3pia"
    },
    "receita_origem_id": {
      "type": "string",
      "description": "Feature 'Minhas Receitas': quando preenchido, indica que esta \u00e9 uma c\u00f3pia pessoal derivada de outra receita. Aponta para o ID da receita original."
    },
    "usuario_dono_id": {
      "type": "string",
      "description": "Feature 'Minhas Receitas': ID do usu\u00e1rio dono desta c\u00f3pia pessoal. Se nulo, a receita \u00e9 original/p\u00fablica do Laborat\u00f3rio."
    },
    "data_personalizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Feature 'Minhas Receitas': data/hora de cria\u00e7\u00e3o da c\u00f3pia pessoal (preenchida automaticamente)"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_base": true
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}