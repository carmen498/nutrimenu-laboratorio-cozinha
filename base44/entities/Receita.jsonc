{
  "name": "Receita",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da receita"
    },
    "categorias": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "Carnes Bovinas e Suínos",
          "Aves",
          "Peixes e Frutos do Mar",
          "Ovos",
          "Massas, Pastelão e Quiches",
          "Arroz e Risotos",
          "Sopas e Caldos",
          "Leguminosas",
          "Salgadinhos",
          "Pães e Bolos",
          "Sobremesas",
          "Molhos",
          "Acompanhamentos",
          "Pratos Principais",
          "Entradas",
          "Lanche",
          "Receitas Base"
        ]
      },
      "default": [],
      "description": "Categorias da receita (múltiplas)"
    },
    "porcoes_base": {
      "type": "number",
      "description": "Número de porções base"
    },
    "rendimento_total": {
      "type": "number",
      "description": "LEGADO/CACHE compatível do peso pós-preparo (PDP). Novas gravações devem manter sincronizado com peso_pos_preparo_total."
    },
    "peso_pre_preparo_total": {
      "type": "number",
      "description": "Snapshot do peso/volume líquido total imediatamente antes do preparo/cocção. Não inclui FC de compra."
    },
    "peso_pos_preparo_total": {
      "type": "number",
      "description": "Peso/volume total depois de pronto (PDP), usado como rendimento técnico canônico."
    },
    "rendimento_origem": {
      "type": "string",
      "enum": ["medido", "estimado", "legado", "importado"],
      "description": "Origem do valor de rendimento/PDP."
    },
    "rendimento_status": {
      "type": "string",
      "enum": ["confirmado", "estimado", "a_validar", "pendente"],
      "description": "Estado técnico do rendimento. Confirmado = PDP medido; a_validar = existe valor sem validação técnica; pendente = sem PDP medido."
    },
    "rendimento_medido_em": {
      "type": "string",
      "format": "date-time",
      "description": "Data/hora da última medição confirmada do peso pós-preparo."
    },
    "unidade_base": {
      "type": "string",
      "enum": [
        "g",
        "ml"
      ],
      "description": "Unidade base da receita: g (sólidos) ou ml (líquidos)"
    },
    "modo_preparo": {
      "type": "string",
      "description": "Modo de preparo"
    },
    "descritivo_menu": {
      "type": "string",
      "description": "Descritivo da receita voltado ao cliente final (para menu/cardápio)"
    },
    "mostrar_fc": {
      "type": "boolean",
      "default": false,
      "description": "Exibir colunas FC e Peso Bruto na tabela de ingredientes da ficha"
    },
    "mostrar_medida_caseira": {
      "type": "boolean",
      "default": false,
      "description": "Exibir coluna Medida Caseira na tabela de ingredientes da ficha"
    },
    "foto_url": {
      "type": "string",
      "description": "URL da foto da receita"
    },
    "custo_total": {
      "type": "number",
      "description": "Custo total calculado"
    },
    "custo_insumos": {
      "type": "number",
      "description": "Custo total de insumos e embalagens"
    },
    "custo_por_porcao": {
      "type": "number",
      "description": "Custo por porção calculado"
    },
    "revisar": {
      "type": "boolean",
      "description": "Flag: Duplicado — revisar"
    },
    "favorita": {
      "type": "boolean",
      "default": false,
      "description": "Flag: Receita favorita"
    },
    "per_capita_g": {
      "type": "number",
      "description": "Per capita recomendado em gramas (override do usuário)"
    },
    "nota": {
      "type": "string",
      "description": "Nota/observações livres da receita (ex: ajustes, ingredientes pendentes de importação)"
    },
    "cor_predominante": {
      "type": "string",
      "description": "Cor predominante do prato para análise visual do cardápio. Formato: `familia__tom` (ex: verde__escuro). Vazio = sem cor."
    },
    "destaque": {
      "type": "boolean",
      "default": false,
      "description": "Receita marcada manualmente para aparecer na vitrine 'Receitas em Destaque' da Home"
    },
    "is_base": {
      "type": "boolean",
      "default": true,
      "description": "true = receita do catálogo compartilhado original; false = cópia pessoal criada automaticamente ao editar (fork-on-edit)"
    },
    "forked_from_id": {
      "type": "string",
      "description": "Quando is_base=false, ID da receita original (is_base=true) da qual esta é uma cópia"
    },
    "receita_origem_id": {
      "type": "string",
      "description": "Feature 'Minhas Receitas': quando preenchido, indica que esta é uma cópia pessoal derivada de outra receita. Aponta para o ID da receita original."
    },
    "usuario_dono_id": {
      "type": "string",
      "description": "Feature 'Minhas Receitas': ID do usuário dono desta cópia pessoal. Se nulo, a receita é original/pública do Laboratório."
    },
    "data_personalizacao": {
      "type": "string",
      "format": "date-time",
      "description": "Feature 'Minhas Receitas': data/hora de criação da cópia pessoal (preenchida automaticamente)"
    }
  },
  "required": [
    "nome"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.is_base": true
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}
