{
  "name": "ConfiguracaoPlano",
  "type": "object",
  "properties": {
    "produto": {
      "type": "string",
      "enum": [
        "laboratorio_cozinha",
        "laboratorio_custos",
        "guia_zr"
      ],
      "default": "laboratorio_cozinha",
      "description": "Produto ao qual a oferta pertence. Registros legados sem produto s\u00e3o tratados como Laborat\u00f3rio de Cozinha."
    },
    "plano_id": {
      "type": "string",
      "enum": [
        "trial",
        "mensal",
        "anual",
        "renovacao",
        "custos_trial",
        "custos_mensal",
        "custos_anual",
        "zr_tin",
        "zr_tin_renovacao",
        "zr_full",
        "zr_full_renovacao",
        "zr_arquitetura",
        "zr_arquitetura_renovacao",
        "zr_full_upgrade_tin",
        "zr_full_upgrade_arquitetura",
        "zr_full_upgrade_tin_arquitetura"
      ],
      "description": "Identificador fixo da oferta. Ofertas do Laborat\u00f3rio de Custos usam prefixo custos_; as faixas do Guia T\u00e9cnico ZR usam prefixo zr_. Ofertas de upgrade (zr_full_upgrade_*) concedem a faixa full por pre\u00e7o menor, exigindo faixas inferiores ativas."
    },
    "nome": {
      "type": "string",
      "description": "Nome do plano exibido no card."
    },
    "subtitulo": {
      "type": "string",
      "description": "Texto de destaque/subt\u00edtulo abaixo do nome."
    },
    "preco_exibido": {
      "type": "number",
      "description": "Valor num\u00e9rico exibido em destaque no card."
    },
    "periodo_exibido": {
      "type": "string",
      "enum": [
        "mes",
        "ano",
        "unico"
      ],
      "default": "mes",
      "description": "Sufixo exibido junto ao pre\u00e7o em destaque."
    },
    "preco_detalhe": {
      "type": "string",
      "description": "Texto complementar menor abaixo do pre\u00e7o em destaque."
    },
    "preco_apos_promocao": {
      "type": "number",
      "minimum": 0,
      "description": "Pre\u00e7o que passar\u00e1 a valer depois da data promocional. Gera a frase 'R$ X at\u00e9 DD/MM; depois R$ Y'. Nunca usar pre\u00e7o riscado em produto que n\u00e3o teve pre\u00e7o praticado antes."
    },
    "promocao_valida_ate": {
      "type": "string",
      "format": "date",
      "description": "\u00daltimo dia do pre\u00e7o promocional de lan\u00e7amento. Vazio = sem promo\u00e7\u00e3o."
    },
    "valor_cobranca": {
      "type": "number",
      "description": "Valor real cobrado no checkout, decidido sempre no servidor."
    },
    "desconto_primeira_assinatura_pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 90,
      "default": 0,
      "description": "Desconto (%) da oferta de fim de trial (48 h) para a primeira assinatura deste plano. 0 = sem oferta. Aplicado server-side; s\u00f3 para mensal/anual do Laborat\u00f3rio de Cozinha."
    },
    "beneficios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Lista de benef\u00edcios/funcionalidades inclu\u00eddas."
    },
    "mais_popular": {
      "type": "boolean",
      "default": false,
      "description": "Quando true, exibe destaque visual no card."
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o dentro do produto."
    },
    "venda_habilitada": {
      "type": "boolean",
      "default": true,
      "description": "Controla se esta oferta pode ser usada comercialmente. Para Laborat\u00f3rio de Custos e para as faixas do Guia T\u00e9cnico ZR permanece false at\u00e9 homologa\u00e7\u00e3o."
    },
    "versao_oferta": {
      "type": "string",
      "description": "Vers\u00e3o comercial da oferta para rastreabilidade."
    }
  },
  "required": [
    "plano_id",
    "nome"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}