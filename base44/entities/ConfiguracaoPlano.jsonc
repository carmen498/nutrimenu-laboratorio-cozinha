{
  "name": "ConfiguracaoPlano",
  "type": "object",
  "properties": {
    "produto": {
      "type": "string",
      "enum": [
        "laboratorio_cozinha",
        "laboratorio_custos"
      ],
      "default": "laboratorio_cozinha",
      "description": "Produto ao qual a oferta pertence. Registros legados sem produto s\u00e3o tratados como Laborat\u00f3rio de Cozinha."
    },
    "plano_id": {
      "type": "string",
      "enum": [
        "trial",
        "mensal",
        "anual",
        "renovacao",
        "custos_trial",
        "custos_mensal",
        "custos_anual"
      ],
      "description": "Identificador fixo da oferta. Ofertas do Laborat\u00f3rio de Custos usam prefixo custos_."
    },
    "nome": {
      "type": "string",
      "description": "Nome do plano exibido no card."
    },
    "subtitulo": {
      "type": "string",
      "description": "Texto de destaque/subt\u00edtulo abaixo do nome."
    },
    "preco_exibido": {
      "type": "number",
      "description": "Valor num\u00e9rico exibido em destaque no card."
    },
    "periodo_exibido": {
      "type": "string",
      "enum": [
        "mes",
        "ano",
        "unico"
      ],
      "default": "mes",
      "description": "Sufixo exibido junto ao pre\u00e7o em destaque."
    },
    "preco_detalhe": {
      "type": "string",
      "description": "Texto complementar menor abaixo do pre\u00e7o em destaque."
    },
    "valor_cobranca": {
      "type": "number",
      "description": "Valor real reservado para cobran\u00e7a server-side quando o checkout do respectivo produto estiver homologado."
    },
    "beneficios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Lista de benef\u00edcios/funcionalidades inclu\u00eddas."
    },
    "mais_popular": {
      "type": "boolean",
      "default": false,
      "description": "Quando true, exibe destaque visual no card."
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o dentro do produto."
    },
    "venda_habilitada": {
      "type": "boolean",
      "default": true,
      "description": "Controla se esta oferta pode ser usada comercialmente. Para Laborat\u00f3rio de Custos permanece false at\u00e9 homologa\u00e7\u00e3o."
    },
    "versao_oferta": {
      "type": "string",
      "description": "Vers\u00e3o comercial da oferta para rastreabilidade."
    }
  },
  "required": [
    "plano_id",
    "nome"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}