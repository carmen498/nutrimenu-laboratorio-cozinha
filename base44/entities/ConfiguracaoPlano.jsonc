{
  "name": "ConfiguracaoPlano",
  "type": "object",
  "properties": {
    "plano_id": {
      "type": "string",
      "enum": [
        "trial",
        "mensal",
        "anual",
        "renovacao"
      ],
      "description": "Identificador fixo do plano \u2014 usado para casar com o Pagamento e determinar o valor cobrado no checkout"
    },
    "nome": {
      "type": "string",
      "description": "Nome do plano exibido no card (ex: Mensal)"
    },
    "subtitulo": {
      "type": "string",
      "description": "Texto de destaque/subt\u00edtulo abaixo do nome (ex: Sem compromisso)"
    },
    "preco_exibido": {
      "type": "number",
      "description": "Valor num\u00e9rico exibido em destaque no card (ex: 29.90, ou 16.50 para o equivalente mensal do plano anual)"
    },
    "periodo_exibido": {
      "type": "string",
      "enum": [
        "mes",
        "ano",
        "unico"
      ],
      "default": "mes",
      "description": "Sufixo exibido junto ao pre\u00e7o em destaque (/m\u00eas, /ano, ou nenhum para valor \u00fanico)"
    },
    "preco_detalhe": {
      "type": "string",
      "description": "Texto complementar menor abaixo do pre\u00e7o em destaque (ex: 'R$ 198/ano', 'ou 6x de R$ 16,50')"
    },
    "valor_cobranca": {
      "type": "number",
      "description": "Valor real, em R$, cobrado no checkout via Mercado Pago para este plano (fonte \u00fanica de verdade do pre\u00e7o cobrado)"
    },
    "beneficios": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Lista de benef\u00edcios/funcionalidades inclu\u00eddas, exibida no card do plano"
    },
    "mais_popular": {
      "type": "boolean",
      "default": false,
      "description": "Quando true, exibe o destaque visual 'Mais popular' no card"
    },
    "ordem": {
      "type": "number",
      "default": 0,
      "description": "Ordem de exibi\u00e7\u00e3o dos cards na tela p\u00fablica de Planos"
    }
  },
  "required": [
    "plano_id",
    "nome"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}