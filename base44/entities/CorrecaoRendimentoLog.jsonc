{
  "name": "CorrecaoRendimentoLog",
  "type": "object",
  "properties": {
    "receita_id": {
      "type": "string",
      "description": "ID da receita corrigida"
    },
    "receita_nome": {
      "type": "string",
      "description": "Nome da receita (cache)"
    },
    "rendimento_anterior": {
      "type": "number",
      "description": "Valor de rendimento_total antes da corre\u00e7\u00e3o (g)"
    },
    "rendimento_novo": {
      "type": "number",
      "description": "Valor de rendimento_total depois da corre\u00e7\u00e3o (g), igual \u00e0 soma dos ingredientes"
    }
  },
  "required": [
    "receita_id",
    "rendimento_anterior",
    "rendimento_novo"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}