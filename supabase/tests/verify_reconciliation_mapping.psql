do $verification$
begin
  if (select count(*) from labcozinha.profiles_legacy) <> 1
    or (select count(*) from public.profiles) <> 1 then
    raise exception 'synthetic reconciliation counts differ';
  end if;

  if not exists (
    select 1
    from public.profiles as canonical
    where canonical.user_id = '10000000-0000-4000-8000-000000000001'
      and canonical.legacy_id = 'fixture-profile-001'
      and canonical.display_name = 'Perfil Sintético'
      and canonical.phone = '+550000000000'
      and canonical.business_name = 'Empresa Sintética'
      and canonical.tax_id = '00000000000'
      and canonical.legal_name = 'Razão Social Sintética'
      and canonical.postal_code = '00000000'
      and canonical.city_state = 'Cidade/UF'
      and canonical.address = 'Endereço Sintético'
      and canonical.professional_segment = 'Nutricionista'
      and canonical.acquisition_source = 'Google'
      and canonical.last_login_at = '2026-08-31 12:00:00+00'
      and canonical.terms_accepted_at = '2026-07-02 10:00:00+00'
      and canonical.terms_version = 'terms-fixture'
      and canonical.privacy_version = 'privacy-fixture'
      and canonical.created_at = '2026-08-01 08:00:00+00'
      and canonical.updated_at = '2026-08-02 09:30:00+00'
  ) then
    raise exception 'synthetic profile mapping differs from the approved contract';
  end if;

  if not exists (
    select 1
    from labcozinha.profiles_legacy as legacy
    where legacy.id = '10000000-0000-4000-8000-000000000001'
      and legacy.plano_atual = 'plano-fixture'
      and legacy.status_assinatura = 'status-fixture'
      and legacy.trial_modelo = 'trial-fixture'
      and legacy.trial_dias_uso = '[1, 3]'::jsonb
      and legacy.pagamento_ativo_id = 'payment-fixture'
      and legacy.ciclo_renovacao = 2
  ) then
    raise exception 'synthetic commercial fields were not preserved in the legacy snapshot';
  end if;
end
$verification$;
