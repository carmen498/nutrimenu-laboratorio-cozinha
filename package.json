{
  "name": "base44-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "20.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "test:renewal": "node scripts/test-plano-renovacao.mjs",
    "test:orcamento": "node scripts/test-orcamento-evento.mjs",
    "test:cardapio": "node scripts/test-cardapio-etapa-12.mjs",
    "test:security": "node scripts/test-rls-children.mjs && node scripts/test-scheduled-functions.mjs && node scripts/test-subscription-matrix.mjs && node scripts/test-auth-routing.mjs && npm run test:renewal",
    "audit:security": "npm audit --audit-level=moderate",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "test:build-budget": "node scripts/test-build-budget.mjs",
    "test:cost-scaling": "node scripts/test-escalonamento-custos.mjs",
    "test:cost-signature": "node scripts/test-custo-assinatura.mjs && node scripts/test-custo-assinatura-subreceita.mjs",
    "test:cost-reference": "node scripts/test-divergencia-ingrediente.mjs && node scripts/test-curadoria-divergencia-ingrediente.mjs",
    "test:cost-lab": "node scripts/test-laboratorio-custos.mjs",
    "test:cost-lab:journey": "node scripts/test-laboratorio-custos-jornada.mjs",
    "test:cost-lab:closing": "node scripts/test-laboratorio-custos-fechamento.mjs",
    "cost-lab:check": "npm run typecheck && npm run test:cost-lab && npm run test:cost-lab:journey && npm run test:cost-lab:closing && npm run build",
    "maintenance:check": "npm run typecheck && npm run lint && npm run test:orcamento && npm run build && npm run test:build-budget && npm run test:cost-scaling && npm run test:cost-signature && npm run test:cost-reference && npm run test:security && npm run audit:security && npm run audit:production",
    "test:go-live": "node scripts/test-go-live-static.mjs",
    "test:production-routes": "node scripts/test-production-routes.mjs",
    "test:auth-production": "node scripts/test-auth-production.mjs",
    "test:auth-e2e-temp": "node scripts/test-auth-e2e-temp-mail.mjs",
    "test:tenant-e2e-temp": "node scripts/test-tenant-isolation-e2e-temp.mjs",
    "go-live:check": "npm run maintenance:check && npm run test:go-live",
    "ci:check": "npm run go-live:check",
    "release:check": "npm run ci:check && npm run test:production-routes && npm run test:auth-production",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base44/sdk": "^0.8.46",
    "@base44/vite-plugin": "^1.0.34",
    "@hello-pangea/dnd": "^17.0.0",
    "@hookform/resolvers": "^4.1.2",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-aspect-ratio": "^1.1.15",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-menubar": "^1.1.24",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@stripe/react-stripe-js": "^3.0.0",
    "@stripe/stripe-js": "^5.2.0",
    "@tanstack/react-query": "^5.102.8",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "embla-carousel-react": "^8.5.2",
    "framer-motion": "^11.16.4",
    "html2canvas": "^1.4.1",
    "input-otp": "^1.5.0",
    "jspdf": "^4.2.1",
    "lodash": "^4.17.21",
    "lucide-react": "^0.475.0",
    "moment": "^2.30.1",
    "next-themes": "^0.4.4",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.87.0",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^7.18.3",
    "recharts": "^2.15.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.185.1",
    "vaul": "^1.1.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.1.0"
  }
}
